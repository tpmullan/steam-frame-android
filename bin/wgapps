#!/bin/bash
# wgapps: run the Waydroid LineageOS 20 GAPPS image in rootless podman on the
# Steam Frame. Everything lives under $HOME so SteamOS updates keep it.
# https://github.com/tpmullan/steam-frame-android (see README.md).
set -euo pipefail

# Steam injects its overlay into everything it launches via LD_PRELOAD, which
# breaks podman's helpers (pasta exits, so Android gets no network). Lepton's
# launcher clears it the same way.
export LD_PRELOAD=
unset LD_LIBRARY_PATH

# Always talk to the user's own session, whichever shell this runs in. A
# terminal inside a nested desktop session has another XDG_RUNTIME_DIR
# (e.g. /run/user/1000/nested_plasma); podman then looks for the container's
# state there ("container ... does not exist", "sd-bus ... Input/output
# error", and `status` saying "stopped" for a running Android).
# docs/bugs/2026-11-15-wrong-session-podman.md
XDG_RUNTIME_DIR="/run/user/$(id -u)"
export XDG_RUNTIME_DIR
if [[ -S "$XDG_RUNTIME_DIR/bus" ]]; then
	export DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"
fi

BASE="${WGAPPS_BASE:-$HOME/.local/share/waydroid-gapps}"
ROOTFS="$BASE/rootfs"
DATA="$BASE/data"
RUNDIR="$BASE/run"
SHARE="$BASE/share"
BIN="$BASE/bin"
APPS_CONF="$BASE/apps.conf"
NAME="${WGAPPS_NAME:-waydroid-gapps}"
DEFAULT_IMAGE="ghcr.io/tpmullan/steam-frame-android"
ADB_PORT="${WGAPPS_ADB_PORT:-5556}"
HOST_UID="$(id -u)"
XDG="/run/user/$HOST_UID"
WAYLAND_SOCKET="${WGAPPS_WAYLAND_SOCKET:-$XDG/gamescope-0}"

log() { printf '%s wgapps: %s\n' "$(date '+%F %T')" "$*" >&2; }
die() {
	log "$*"
	exit 1
}

usage() {
	cat <<EOF
usage: wgapps <command> [args]
  install [--vanilla]  check prerequisites, download Waydroid's GAPPS images from
                       Waydroid, extract them, add the Android Steam shortcut;
                       --vanilla installs the images without Google apps
  update [tag|ref]     replace these scripts and overrides with a released image
                       (default: latest); Android data is not touched
  rollback             undo the last update
  uninstall [--yes]    stop Android, remove Steam shortcuts, delete everything
                       under $BASE (Android data included)
  version              installed release
  gsf-id               print the GSF ID to register at google.com/android/uncertified
  prepare [--force]    extract images/*.img into rootfs
  start [--headless]   boot Android (display on gamescope unless --headless)
  stop                 shut the container down
  status               container state and boot progress
  wait-boot [secs]     block until sys.boot_completed=1 (default 180s)
  sh [cmd...]          run a command (or shell) inside Android as root
  logcat [args...]     Android logcat
  launch <package>     start or reuse Android, open the package's launcher activity
  run <package>        launch, then block until the app's process exits
  app set <package> <key> <value>
                       make one app see a different device property (keys: model,
                       manufacturer, brand, device), e.g.
                       app set com.igalia.wolvic.vanilla model "Quest 3"
  app unset <package> [key]   undo it (all of the package's keys without a key)
  app list             show the per-app overrides
  app import <file>    replace them with the valid lines of a file (what the
                       "Device profile per app" screen in Android's Settings does)
  apps list            the apps you can open: package, label, activity, kind (xr or 2d)
  apps push            write the app list the VR shell reads (done at shell start)
  apps sync            make the Steam library match: one entry per app, gone apps removed
  apps kind <package> xr|2d|auto
                       treat an app as OpenXR or flat whatever detection says
  share [add <path> [name] [--rw]|remove <name>]
                       folders from this computer inside Android's storage (the Files app):
                       ~/Android-share is always there as "Host" (read-write); added folders,
                       any directory including your home, are read-only unless --rw (restart Android)
  windows [floating|single]
                       show or set how apps open: floating = movable windows inside
                       Android's one panel, single = each app fills it (restart Android)
  view panel|vr        switch the running Android between the VR shell and the flat panel
  mode [steam|vr|home [on|off]]
                       show or set the mode (steam: every app a Steam entry; vr: the
                       optional VR shell, needs lib/StarforgeShell.apk or WgappsShell.apk) and the 3D home
  gpu egl [mesa|angle] show or set the GLES implementation (default mesa; restart Android)
  xr scale [1.0-2.0|default] show or set how much larger than SteamVR's recommendation OpenXR apps
                        render (default 1.25 = the Frame's panel size; restart Android)
  report [file]        write a diagnostics file to attach to a bug report (no
                       passwords or account data; see docs/runbook-logs.md)
  steam [package]      Steam shortcut entry point: (re)start Android under Steam's
                       reaper so gamescope ties the window to the Steam app, open
                       the package if given, block until Steam quits it
EOF
}

running() {
	[[ "$(podman inspect -f '{{.State.Running}}' "$NAME" 2>/dev/null)" == "true" ]]
}

asys() {
	podman exec "$NAME" /system/bin/sh -c "$*"
}

write_props() {
	local headless="$1" tz
	tz="$(readlink /etc/localtime)"
	tz="${tz#/usr/share/zoneinfo/}"
	mkdir -p "$RUNDIR"
	{
		echo "sys.use_memfd=true"
		echo "bpf.progs_loaded=1"
		echo "ro.cold_boot_done=true"
		echo "ro.vndk.lite=true"
		echo "ro.opengles.version=196609"
		echo "ro.sf.lcd_density=${WGAPPS_DENSITY:-240}"
		echo "ro.hardware.egl=$(gpu_egl)"
		echo "ro.hardware.vulkan=freedreno"
		echo "ro.hardware.gralloc=minigbm_gbm_mesa"
		echo "ro.hardware.camera=v4l"
		echo "config.disable_cameraservice=true"
		# Codec2 input buffers default to the ION/DMA-BUF heap, but the host's
		# /dev/dma_heap/system is root-only. Add the BLOB allocator (gralloc)
		# to the default ION|BUFFERQUEUE mask: (1<<16)|(1<<18)|(1<<19).
		if hw_decode_enabled; then
			echo "debug.stagefright.c2-poolmask=$HWDEC_POOLMASK"
			echo "ro.vendor.v4l2_codec2.decode_concurrent_instances=8"
			echo "ro.vendor.v4l2_codec2.encode_concurrent_instances=8"
			echo "ro.vendor.v4l2_codec2.min_input_buffer_size=$HWDEC_MIN_INPUT"
		else
			echo "debug.stagefright.c2-poolmask=851968"
		fi
		# OpenXR apps size their render targets from SteamVR's recommendation, which is 80% of
		# the panel; our OpenXR layer scales it up (see xr-layer/gles_layer.c).
		echo "debug.xr.render_scale=$(xr_scale)"
		if egl_layer_enabled; then echo "debug.gles.layers=$EGL_LAYER"; fi
		echo "waydroid.host.user=$(id -un)"
		echo "waydroid.host.uid=$HOST_UID"
		echo "waydroid.host.gid=$(id -g)"
		echo "waydroid.xdg_runtime_dir=/waydroid/xdg"
		echo "waydroid.pulse_runtime_path=/waydroid/xdg/pulse"
		echo "waydroid.stub_sensors_hal=1"
		# Where Steam's client library lives (see mount_xr).
		echo "lepton.steamclient.path=/system/lib64/libsteamclient.so"
		# The Frame pointer arrives as a Wayland mouse; treat it as touch in every
		# app so launcher and system gestures (swipe up for apps) work.
		echo "persist.waydroid.fake_touch=${WGAPPS_FAKE_TOUCH:-*}"
		echo "waydroid.wayland_display=wayland-0"
		if [[ "$(windows_mode)" == "floating" ]]; then
			# Tasks become freeform windows with caption buttons, all drawn into the one panel.
			echo "persist.waydroid.multi_windows=true"
		fi
		if [[ "$headless" == "true" ]]; then
			echo "waydroid.background_start=true"
		else
			echo "waydroid.background_start=false"
		fi
		echo "persist.sys.timezone=$tz"
		echo "service.adb.tcp.port=$ADB_PORT"
		app_wrap_props
		if [[ -f "$BASE/device.prop" ]]; then
			cat "$BASE/device.prop"
		fi
	} >"$RUNDIR/waydroid.prop"
	# Android init refuses group-writable property files.
	chmod 0644 "$RUNDIR/waydroid.prop"
}

cmd_prepare() {
	local img="$BASE/images"
	[[ -f "$img/system.img" && -f "$img/vendor.img" ]] || die "missing $img/{system,vendor}.img"
	if running; then
		die "stop the container first"
	fi
	[[ -f "$img/DONE" ]] || die "images not downloaded yet (wgapps install)"
	if [[ "${1:-}" == "--force" || ! -d "$ROOTFS/system" ]]; then
		local tmp="$BASE/rootfs.new"
		podman unshare rm -rf "$tmp"
		mkdir -p "$tmp"
		log "extracting system.img and vendor.img"
		podman unshare sh -c '
			set -e
			debugfs -R "rdump / $1" "$2/system.img" >/dev/null 2>&1
			rm -rf "$1/vendor"
			mkdir "$1/vendor.new"
			debugfs -R "rdump / $1/vendor.new" "$2/vendor.img" >/dev/null 2>&1
			mv "$1/vendor.new" "$1/vendor"
		' sh "$tmp" "$img"
		podman unshare rm -rf "$ROOTFS"
		mv "$tmp" "$ROOTFS"
		rm -rf "$BASE/overrides-generated"
	fi
	generate_overrides
	log "rootfs ready at $ROOTFS"
}

# Fixes that edit files from Waydroid's vendor image are generated from the
# user's own extracted image (see wgapps-gen-overrides), never shipped.
generate_overrides() {
	local out="$BASE/overrides-generated"
	[[ -d "$out" ]] && return 0
	rm -rf "$out.new"
	python3 "$BIN/wgapps-gen-overrides" "$ROOTFS" "$out.new" >&2 ||
		die "cannot generate overrides from $ROOTFS"
	mv "$out.new" "$out"
}

NET_SUBNET=172.20.0
NET_ADDR="$NET_SUBNET.2"

# Rootless podman has 65,537 IDs: the host user (intermediate 0) plus the
# 65,536 subordinate IDs (intermediate 1..65536). Android needs app UIDs up
# to 19999 and isolated-process UIDs 90000-99999 (WebView and Chrome
# renderers), plus shared app GIDs 50000-59999, so map only the ranges it
# uses. Container root is the host user, which owns the gamescope and
# PulseAudio sockets.
IDMAP=(
	--uidmap 0:0:1 --uidmap 1:1:19999 --uidmap 90000:20000:10000
	--gidmap 0:0:1 --gidmap 1:1:39999 --gidmap 50000:40000:10000 --gidmap 90000:50000:10000
)
IDMAP_VERSION=2

# Data created under the earlier contiguous mapping (container ID ==
# intermediate ID) has shared app GIDs 50000-59999 at intermediate
# 50000-59999; under IDMAP those are intermediate 40000-49999. Runs inside
# `podman unshare`.
migrate_data_ids() {
	local data="$1" f gid
	while IFS= read -r -d '' f; do
		gid="$(stat -c %g "$f")"
		chown -h ":$((gid - 10000))" "$f"
	done < <(find "$data" -xdev -gid +49999 -gid -60000 -print0)
}

# keystore2 runs as uid 1017 and aborts at boot ("Failed to attach database
# persistent", open() -> EACCES) when /data/misc/keystore holds files owned by
# root. A boot under Lepton's 2026-10-09 seccomp profile, which fakes setuid and
# chown, leaves them that way, so a Frame that booted once under it loops forever
# even after the profile is fixed. docs/bugs/2026-11-15-keystore-owner.md
# Runs inside `podman unshare`, where container ID N is ID N.
AID_KEYSTORE=1017
repair_keystore_owner() {
	local dir="$1"
	[[ -d "$dir" ]] || return 0
	find "$dir" -xdev ! -uid "$AID_KEYSTORE" -exec chown -h "$AID_KEYSTORE:$AID_KEYSTORE" {} +
}

ensure_idmap() {
	local marker="$BASE/.idmap-version"
	[[ "$(cat "$marker" 2>/dev/null)" == "$IDMAP_VERSION" ]] && return 0
	if [[ -d "$DATA" && -n "$(ls -A "$DATA" 2>/dev/null)" ]]; then
		log "migrating Android data to ID map v$IDMAP_VERSION"
		podman unshare "$0" _migrate-ids "$DATA"
	fi
	echo "$IDMAP_VERSION" >"$marker"
}

bind() {
	local src="$1" dst="$2" opt="${3:-rw}"
	[[ -e "$src" ]] || return 0
	ARGS+=(--mount "type=bind,source=$src,destination=$dst,$opt")
}

# Seccomp profile for Android in the container: everything is allowed except
# what a container has no business doing (kernel modules, kexec, changing the
# clock) and open_by_handle_at. Calls a rootless container is not allowed to
# make but Android makes at boot (setpriority, nice, the clock) are answered
# with success instead of EPERM; with EPERM init cannot start zygote and
# Android never finishes booting.
#
# Always ours, never Valve's Lepton profile: since 2026-10-09 Lepton's also
# answers setuid, setgid, setgroups and chown with fake success (its Android
# runs without separate uids). Here init then believes it became the service's
# user while still root, and the exec of a 0550 binary owned by that user fails
# ("cannot execv('/system/bin/logd') ... Permission denied"): logd, then
# everything after it, never starts. docs/bugs/2026-11-15-lepton-seccomp-boot.md
write_seccomp() {
	local out="$RUNDIR/android.seccomp.json"
	cat >"$out" <<'JSON'
{
  "defaultAction": "SCMP_ACT_ALLOW",
  "syscalls": [
    {"names": ["open_by_handle_at"], "action": "SCMP_ACT_ERRNO", "errnoRet": 38},
    {"names": ["adjtimex", "clock_adjtime", "clock_adjtime64", "clock_settime",
               "clock_settime64", "settimeofday", "swapon", "swapoff", "setpriority",
               "nice", "keyctl", "request_key"],
     "action": "SCMP_ACT_ERRNO", "errnoRet": 0},
    {"names": ["init_module", "finit_module", "delete_module", "_sysctl",
               "kexec_file_load", "kexec_load", "reboot"],
     "action": "SCMP_ACT_ERRNO"}
  ]
}
JSON
	echo "$out"
}

# Lepton-style XR plumbing, from the host's SteamOS install (nothing of
# Valve's is shipped here). Each piece is skipped when absent; WGAPPS_XR=0
# disables all of it.
#   Steam: the Android client libraries from Steam's install, listed in
#     public.libraries.txt so apps may load them.
#   OpenXR: apps bring their own loader, which reads
#     /vendor/etc/openxr/1/active_runtime.json. That names SteamVR's Android
#     client (vrclient.so) in the host's SteamVR, mounted at /data/steamvr
#     (/data is the one place outside an app's own directory it may dlopen
#     from). vrclient reads its paths from the environment, which apps inherit
#     from zygote.
# Not ported: Valve's Vulkan layers (shader cache, foveation) and the OpenXR
# layer manifest under /usr/share/guestos. Lepton loads them through a hook in
# its patched image, and the OpenXR half without the Vulkan half breaks
# swapchains.
STEAM_ANDROID_LIBS="${WGAPPS_STEAM_ANDROID_LIBS:-$HOME/.local/share/Steam/androidarm64}"
VRCLIENT=bin/androidarm64/vrclient.so
XR_LAYER=libwgapps_xr_gles

# Where the host's SteamVR keeps its runtime or config: the override if
# set, else what SteamOS's `steamvr` command reports (as Lepton asks it).
steamvr_dir() {
	local override="$1" what="$2"
	if [[ -n "$override" ]]; then
		echo "$override"
	elif command -v steamvr >/dev/null; then
		steamvr "$what" 2>/dev/null || true
	fi
}

mount_xr() {
	[[ "${WGAPPS_XR:-1}" == "0" ]] && return 0
	local lib name pub="$RUNDIR/public.libraries.txt"
	mkdir -p "$RUNDIR"
	if [[ -f "$STEAM_ANDROID_LIBS/libsteamclient.so" && -f "$ROOTFS/system/etc/public.libraries.txt" ]]; then
		# Android only lets apps load libraries listed in public.libraries.txt.
		cp "$ROOTFS/system/etc/public.libraries.txt" "$pub"
		for lib in "$STEAM_ANDROID_LIBS"/*.so; do
			name="${lib##*/}"
			echo "$name nopreload" >>"$pub"
			bind "$lib" "/system/lib64/$name" ro,U
		done
		bind "$pub" /system/etc/public.libraries.txt ro,U
	fi

	local runtime logs config
	runtime="$(steamvr_dir "${WGAPPS_STEAMVR_RUNTIME:-}" path)"
	if [[ -z "$runtime" || ! -f "$runtime/$VRCLIENT" ]]; then
		log "SteamVR's Android client ($VRCLIENT) not found: apps get no OpenXR runtime"
		return 0
	fi
	config="$(steamvr_dir "${WGAPPS_STEAMVR_CONFIG:-}" configpath)"
	# vrclient fails (VRInitError_Init_NoLogPath) unless it can create its log.
	# Lepton shares the host's SteamVR log directory, but there every app is
	# the host user; here each has its own UID, so they get a directory of
	# ours that any of them may write.
	logs="$BASE/steamvr-logs"
	mkdir -p "$logs"
	chmod 1777 "$logs"
	# podman creates the mount points under /data; the host user cannot once
	# Android owns it.
	bind "$runtime" /data/steamvr/runtime rw
	bind "$logs" /data/steamvr/logs rw
	[[ -n "$config" ]] && bind "$config" /data/steamvr/config ro

	cat >"$RUNDIR/active_runtime.json" <<EOF
{
    "file_format_version": "1.0.0",
    "runtime": {
        "name": "steamvr",
        "VALVE_runtime_is_steamvr": true,
        "library_path": "/data/steamvr/runtime/$VRCLIENT"
    }
}
EOF
	bind "$RUNDIR/active_runtime.json" /vendor/etc/openxr/1/active_runtime.json ro
	# The same runtime for apps that use OpenVR.
	cat >"$RUNDIR/openvrpaths.vrpath" <<EOF
{
    "config": ["/data/steamvr/config"],
    "external_drivers": null,
    "jsonid": "vrpathreg",
    "log": ["/data/steamvr/logs"],
    "runtime": ["/data/steamvr/runtime"],
    "version": 1
}
EOF
	bind "$RUNDIR/openvrpaths.vrpath" /vendor/etc/openvrpaths.vrpath ro

	# Our own OpenXR layer (xr-layer/) for OpenGL ES apps: SteamVR has no
	# GL_RGBA8 swapchains, which Wolvic insists on, and cannot create the
	# 16- and 24-bit depth ones it lists, which Khronos hello_xr picks.
	# App loaders read implicit layers from /vendor/etc/openxr/1/api_layers.
	if [[ -f "$BASE/lib/$XR_LAYER.so" ]]; then
		bind "$BASE/lib/$XR_LAYER.so" "/data/steamvr/layers/$XR_LAYER.so" ro
		cat >"$RUNDIR/$XR_LAYER.json" <<EOF
{
    "file_format_version": "1.0.0",
    "api_layer": {
        "name": "XR_APILAYER_WGAPPS_gles_formats",
        "library_path": "/data/steamvr/layers/$XR_LAYER.so",
        "api_version": "1.0",
        "implementation_version": "1",
        "description": "OpenGL ES swapchain formats SteamVR lacks or cannot create",
        "disable_environment": "WGAPPS_XR_NO_GLES_LAYER"
    }
}
EOF
		bind "$RUNDIR/$XR_LAYER.json" \
			"/vendor/etc/openxr/1/api_layers/implicit.d/${XR_LAYER#lib}.json" ro
	fi

	local rc out env
	env="    setenv VR_PATHREG_OVERRIDE /vendor/etc/openvrpaths.vrpath
    setenv VR_CONFIG_PATH /data/steamvr/config
    setenv VR_LOG_PATH /data/steamvr/logs
    setenv Steam3Master $NET_SUBNET.1:57343
"
	# SteamVR names the app to the host by Steam's ID for it.
	if [[ -n "${SteamAppId:-}" ]]; then
		env+="    setenv SteamAppId $SteamAppId
"
	fi
	for rc in "$ROOTFS"/system/etc/init/hw/init.zygote*.rc; do
		[[ -f "$rc" ]] || continue
		out="$RUNDIR/${rc##*/}"
		XR_ENV="$env" awk '{ print } /^service / { printf "%s", ENVIRON["XR_ENV"] }' "$rc" >"$out"
		chmod 0644 "$out"
		bind "$out" "/system/etc/init/hw/${rc##*/}" ro
	done
	return 0
}

# Android's graphics allocator crashes when two requests for buffers the CPU
# can touch arrive together, and Android restarts its UI after it. Preload
# our lock (gbm-lock/) into that service. Not without the library: a service
# cannot start with a preload that is missing.
GBM_LOCK=libwgapps_gbm_lock.so

mount_gbm_lock() {
	local rc=vendor/etc/init/android.hardware.graphics.allocator@4.0-service.minigbm_gbm_mesa.rc
	local out="$RUNDIR/${rc##*/}"
	[[ -f "$BASE/lib/$GBM_LOCK" && -f "$ROOTFS/$rc" ]] || return 0
	mkdir -p "$RUNDIR"
	awk -v lib="/vendor/lib64/$GBM_LOCK" \
		'{ print } /^service / { print "    setenv LD_PRELOAD " lib }' "$ROOTFS/$rc" >"$out"
	chmod 0644 "$out"
	bind "$BASE/lib/$GBM_LOCK" "/vendor/lib64/$GBM_LOCK" ro
	bind "$out" "/$rc" ro
}

# Mesa's Android EGL can deadlock an app: eglQuerySurface(EGL_BUFFER_AGE_EXT) dequeues a buffer with the
# display lock held and the consumer that would free one needs that lock (Wolvic froze a few seconds after
# leaving fullscreen video). Our GLES layer (egl-layer/) answers that one query itself. Android's libEGL
# loads layers named by debug.gles.layers from /data/local/debug/gles. WGAPPS_EGL_LAYER=0 turns it off.
EGL_LAYER=libwgapps_egl_layer.so

egl_layer_enabled() {
	[[ "${WGAPPS_EGL_LAYER:-1}" != 0 && -f "$BASE/lib/$EGL_LAYER" ]]
}

mount_egl_layer() {
	egl_layer_enabled || return 0
	bind "$BASE/lib/$EGL_LAYER" "/data/local/debug/gles/$EGL_LAYER" ro
}

# --- hardware video decode ---------------------------------------------------
# The SoC's V4L2 decoder (iris: H.264, HEVC and VP9 up to 8K) is invisible to Android: the image has
# only Google's software codecs, so YouTube stops at 1080p. $BASE/lib/v4l2-codec2/ holds the Codec2
# V4L2 service built from AOSP's external/v4l2_codec2 against this image, laid out like Android's own
# /vendor (vendor/bin/hw, vendor/lib64, vendor/etc/seccomp_policy). When it is there and this user can
# open the host's decoder node, its files are mounted over /vendor and /system, the node is passed in, and the
# service is declared to Android (init file, HAL manifest fragment, codec list). Without either,
# nothing changes. tools/decode-check.py tests the result.
HWDEC_DIR="$BASE/lib/v4l2-codec2"
HWDEC_SERVICE=vendor/bin/hw/android.hardware.media.c2@1.0-service-v4l2-64
HWDEC_RC=vendor/etc/init/android.hardware.media.c2@1.0-service-v4l2-64.rc
# The bitstream buffer size the iris driver demands (it reports this sizeimage for every
# resolution, whatever is asked; measured with `v4l2-ctl --get-fmt-video-out`). The service's
# default of 1 to 4 MB is rejected at VIDIOC_QBUF, so it is raised through
# ro.vendor.v4l2_codec2.min_input_buffer_size (tools/v4l2-codec2/0002-*.patch).
HWDEC_MIN_INPUT=17694720
# Codec2's buffer pools: the defaults (ION, BUFFERQUEUE, BLOB: see write_props) plus the V4L2 ones.
HWDEC_POOLMASK=$(((1 << 16) | (1 << 18) | (1 << 19) | (1 << 20) | (1 << 21)))

# $HWDEC_DIR holds vendor/ (the service, its libraries, init, policy) and system/lib64/ (the client-side
# plugin store), each laid out like the matching Android partition.

# The host's V4L2 decoder device node when this user may use it (empty otherwise).
hw_decode_node() {
	local node
	node="$(readlink -f "${WGAPPS_V4L2_DECODER:-/dev/video-dec0}" 2>/dev/null)" || return 1
	[[ -c "$node" && -r "$node" && -w "$node" ]] || return 1
	echo "$node"
}

hw_decode_enabled() {
	[[ -x "$HWDEC_DIR/$HWDEC_SERVICE" ]] && hw_decode_node >/dev/null
}

# The init file for the service. It runs as root: inside the rootless container that is the host
# user, who owns the decoder node; Android's own `media` user maps to a sub-ID that may not open it.
hw_decode_init_rc() {
	cat <<EOF
service android-hardware-media-c2-v4l2-hal-1-0 /$HWDEC_SERVICE
    class hal
    user root
    group root
    ioprio rt 4
    setenv MESA_GLSL_CACHE_DISABLE 1
EOF
}

# Codec2 creates the decoder's output pool in two places: the client inside the app (Chrome, Wolvic:
# MediaCodec) names a pool type, and the service builds it. The client first asks the plugin store
# whether the V4L2 allocator ids exist (C2PlatformStorePluginLoader dlopens libc2plugin_store.so), and an
# app cannot load a vendor library (since Android 12 only ones its manifest declares). Without an answer
# the client asks for a plain buffer-queue pool and the V4L2 code crashes on a pool of the wrong type. So
# the build also has a small system-side libc2plugin_store.so (tools/v4l2-codec2/0006-*.patch) that is
# mounted into /system/lib64 next to the service's vendor one.

# The service is sandboxed by a seccomp policy written for the software codecs. The V4L2 code
# needs a few more calls (eventfd2 wakes its poll loop; libchrome's threads and timers use the
# rest), which the project provides a vendor extension file for. A call outside both kills the
# service with SIGSYS and libminijail logs "blocked syscall: <name>" to logcat.
HWDEC_EXT_POLICY=vendor/etc/seccomp_policy/codec2.vendor.ext.policy
hw_decode_ext_policy() {
	local call
	echo "# Added by wgapps for the V4L2 Codec2 service (see hw_decode_ext_policy in bin/wgapps)."
	for call in eventfd2 dup3 fcntl epoll_create1 epoll_ctl epoll_pwait clock_nanosleep \
		sched_getaffinity sched_setaffinity getpriority readv pwrite64; do
		echo "$call: 1"
	done
}

# hwservicemanager only lets a HAL register that the vendor manifest declares.
hw_decode_manifest() {
	cat <<'EOF'
<manifest version="1.0" type="device">
    <hal format="hidl">
        <name>android.hardware.media.c2</name>
        <transport>hwbinder</transport>
        <version>1.0</version>
        <interface>
            <name>IComponentStore</name>
            <instance>default</instance>
        </interface>
        <interface>
            <name>IConfigurable</name>
            <instance>default</instance>
        </interface>
    </hal>
</manifest>
EOF
}

# The decoders as MediaCodecList reports them (limits from the node's 8192x8192 and Android's 4K tiers).
hw_decode_codecs() {
	local name type
	echo '<?xml version="1.0" encoding="utf-8"?>'
	echo '<MediaCodecs>'
	echo '    <Decoders>'
	for name in avc:video/avc hevc:video/hevc vp9:video/x-vnd.on2.vp9; do
		type="${name#*:}"
		name="${name%%:*}"
		cat <<EOF
        <MediaCodec name="c2.v4l2.$name.decoder" type="$type">
            <Limit name="size" min="16x16" max="4096x4096" />
            <Limit name="alignment" value="2x2" />
            <Limit name="block-size" value="16x16" />
            <Limit name="blocks-per-second" range="1-2211840" />
            <Limit name="bitrate" range="1-100000000" />
            <Limit name="concurrent-instances" max="8" />
            <Limit name="performance-point-3840x2160" range="60-60" />
        </MediaCodec>
EOF
	done
	echo '    </Decoders>'
	echo '</MediaCodecs>'
}

mount_hw_decode() {
	local f node
	HW_DECODE_NODE=""
	[[ -x "$HWDEC_DIR/$HWDEC_SERVICE" ]] || return 0
	node="$(hw_decode_node)" || {
		log "hardware video decode: no usable V4L2 decoder node; Android keeps its software codecs"
		return 0
	}
	mkdir -p "$RUNDIR"
	while IFS= read -r -d '' f; do
		f="${f#./}"
		[[ "$f" == "$HWDEC_RC" ]] && continue # ours below
		bind "$HWDEC_DIR/$f" "/$f" ro
	done < <(cd "$HWDEC_DIR" && find vendor system -type f -print0 2>/dev/null)
	hw_decode_init_rc >"$RUNDIR/hwdec.rc"
	hw_decode_manifest >"$RUNDIR/hwdec-manifest.xml"
	hw_decode_codecs >"$RUNDIR/media_codecs_c2.xml"
	hw_decode_ext_policy >"$RUNDIR/codec2.vendor.ext.policy"
	chmod 0644 "$RUNDIR/hwdec.rc" "$RUNDIR/hwdec-manifest.xml" "$RUNDIR/media_codecs_c2.xml" \
		"$RUNDIR/codec2.vendor.ext.policy"
	bind "$RUNDIR/hwdec.rc" "/$HWDEC_RC" ro
	bind "$RUNDIR/hwdec-manifest.xml" /vendor/etc/vintf/manifest/android.hardware.media.c2.v4l2.xml ro
	bind "$RUNDIR/media_codecs_c2.xml" /vendor/etc/media_codecs_c2.xml ro
	bind "$RUNDIR/codec2.vendor.ext.policy" "/$HWDEC_EXT_POLICY" ro
	# The service cannot list /dev (it is sandboxed): it tries /dev/video and /dev/video0 to
	# /dev/video15 only, and the SoC's decoder is /dev/video22. So Android also sees it as video0.
	bind "$node" /dev/video0 rw
	HW_DECODE_NODE="$node"
}

# Per-app overrides: some apps choose their controllers or features by the
# device model Android reports, and an unknown headset gets the bare minimum.
# `wgapps app set` records what one app should see in $APPS_CONF (survives
# updates), one "<package> <key>=<value>" per line. Android runs an app through
# a preload named by the property `wrap.<package>` (this image is userdebug),
# for that app only; ours (props-override/) answers its system-property reads
# from /data/wgapps/props.d/<package>. The files are in a directory bound into
# Android, so a change reaches the next process the app starts, no reboot.
APP_PROPS=libwgapps_props.so
APP_KEYS=(model manufacturer brand device)
# Android keeps a copy of each ro.product.* property per partition and apps
# differ in which they read (Wolvic: vendor; Java's Build.MODEL: none), so a key
# sets them all. A property this Android does not have is skipped by the preload.
APP_PARTITIONS=("" system. vendor. odm. system_ext. vendor_dlkm. product.)

# Package names are at most 54 characters so a `wrap.` property value
# ("LD_PRELOAD=/data/wgapps/props.so WGP=<package>") fits Android's 91.
app_valid_package() {
	local re='^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$'
	[[ "$1" =~ $re && ${#1} -le 54 ]]
}

app_valid_key() {
	local key
	for key in "${APP_KEYS[@]}"; do
		if [[ "$1" == "$key" ]]; then return 0; fi
	done
	return 1
}

# What the value may be: nothing the shell or a property file could take for
# something else.
app_valid_value() {
	local re='^[A-Za-z0-9 ._+()/:-]{1,91}$'
	[[ "$1" =~ $re && "$1" != " "* && "$1" != *" " ]]
}

# Drop the package's key (or all its lines when no key), then add key=value.
app_conf_rewrite() { # package key value
	local pkg="$1" key="$2" value="$3" tmp="$APPS_CONF.new" line
	: >"$tmp"
	if [[ -f "$APPS_CONF" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			if [[ -z "$key" && "$line" == "$pkg "* ]]; then continue; fi
			if [[ -n "$key" && "$line" == "$pkg $key="* ]]; then continue; fi
			printf '%s\n' "$line" >>"$tmp"
		done <"$APPS_CONF"
	fi
	if [[ -n "$value" ]]; then
		printf '%s %s=%s\n' "$pkg" "$key" "$value" >>"$tmp"
	fi
	mv "$tmp" "$APPS_CONF"
}

# $RUNDIR/props.d/<package>: "ro.product.<key>=<value>" per line, for every
# valid line of $APPS_CONF. The directory is bind-mounted into Android, so it
# is never replaced, only its files.
generate_app_props() {
	local dir="$RUNDIR/props.d" line pkg rest key value f partition
	mkdir -p "$dir"
	if [[ -f "$APPS_CONF" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			pkg="${line%% *}"
			rest="${line#* }"
			key="${rest%%=*}"
			value="${rest#*=}"
			if [[ "$line" != *" "* || "$rest" != *=* ]] || ! app_valid_package "$pkg" ||
				! app_valid_key "$key" || ! app_valid_value "$value"; then
				if [[ -n "$line" ]]; then log "ignoring invalid line in $APPS_CONF: $line"; fi
				continue
			fi
			if [[ ! -e "$dir/.$pkg.new" ]]; then : >"$dir/.$pkg.new"; fi
			for partition in "${APP_PARTITIONS[@]}"; do
				printf 'ro.product.%s%s=%s\n' "$partition" "$key" "$value" >>"$dir/.$pkg.new"
			done
		done <"$APPS_CONF"
	fi
	for f in "$dir"/.*.new; do
		[[ -e "$f" ]] || continue
		chmod 0644 "$f"
		pkg="${f##*/.}"
		mv -f "$f" "$dir/${pkg%.new}"
	done
	for f in "$dir"/*; do
		[[ -e "$f" ]] || continue
		[[ "${f##*/}" == "$COMPOSER_PROPS" ]] && continue
		if ! app_conf_has "${f##*/}"; then rm -f "$f"; fi
	done
}

app_conf_has() { # package
	local line
	[[ -f "$APPS_CONF" ]] || return 1
	while IFS= read -r line || [[ -n "$line" ]]; do
		if [[ "$line" == "$1 "* ]]; then return 0; fi
	done <"$APPS_CONF"
	return 1
}

# With ANGLE as the GLES driver (wgapps gpu egl angle) the display's composer
# HAL crashed in ANGLE's eglCreateImageKHR (it imports Android native buffers,
# which ANGLE's Vulkan backend cannot on this driver) and Android's display
# restarted. The composer is only an importer of buffers, so it keeps Mesa's
# EGL: our property preload (props-override/) answers its read of
# ro.hardware.egl with "mesa". Apps and SurfaceFlinger use ANGLE.
# The composer service is defined in the vendor's rc and again, with
# `override`, in init.waydroid.rc and our z_wgapps.rc (the last one wins), so
# every file that defines it gets the two lines.
COMPOSER_RCS=(vendor/etc/init/android.hardware.graphics.composer@2.1-service.rc
	system/etc/init/init.waydroid.rc system/etc/init/z_wgapps.rc)
COMPOSER_PROPS=wgapps.composer

# Patched copies of the rc files are made before the overrides are bound (a
# file Android already gets from overrides/ must be bound once, as the patched
# copy), and the rest are bound by mount_composer_egl afterwards.
composer_patched() { echo "$RUNDIR/composer-${1//\//_}"; }

prepare_composer_egl() {
	local rc out src dir
	rm -f "$RUNDIR/props.d/$COMPOSER_PROPS" "$RUNDIR"/composer-*
	[[ "$(gpu_egl)" == "angle" ]] || return 0
	[[ -f "$BASE/lib/$APP_PROPS" ]] || return 0
	mkdir -p "$RUNDIR/props.d"
	echo "ro.hardware.egl=mesa" >"$RUNDIR/props.d/$COMPOSER_PROPS"
	chmod 0644 "$RUNDIR/props.d/$COMPOSER_PROPS"
	for rc in "${COMPOSER_RCS[@]}"; do
		# What Android would see: an override of the file, else the image's own.
		src=""
		for dir in local-overrides overrides-generated overrides; do
			[[ -f "$BASE/$dir/$rc" ]] && src="$BASE/$dir/$rc" && break
		done
		[[ -n "$src" ]] || src="$ROOTFS/$rc"
		[[ -f "$src" ]] || continue
		out="$(composer_patched "$rc")"
		awk -v lib="/vendor/lib64/$APP_PROPS" -v wgp="$COMPOSER_PROPS" \
			'{ print } /^service vendor.hwcomposer-2-1 / { print "    setenv LD_PRELOAD " lib; print "    setenv WGP " wgp }' \
			"$src" >"$out"
		chmod 0644 "$out"
	done
}

# Whether the overrides loop binds this file (so it is bound there, not here).
overridden() { # relative path
	local dir
	for dir in overrides overrides-generated local-overrides; do
		[[ -f "$BASE/$dir/$1" ]] && return 0
	done
	return 1
}

mount_composer_egl() {
	local rc out
	for rc in "${COMPOSER_RCS[@]}"; do
		out="$(composer_patched "$rc")"
		[[ -f "$out" ]] || continue
		overridden "$rc" || bind "$out" "/$rc" ro
	done
	[[ -f "$(composer_patched "${COMPOSER_RCS[0]}")" || -f "$RUNDIR/props.d/$COMPOSER_PROPS" ]] &&
		bind "$BASE/lib/$APP_PROPS" "/vendor/lib64/$APP_PROPS" ro
	return 0
}

# The properties Android's init sets at boot: one `wrap.` per package with
# overrides. Not without the library: an app cannot start with a preload that
# is missing.
app_wrap_props() {
	local f
	[[ -f "$BASE/lib/$APP_PROPS" ]] || return 0
	for f in "$RUNDIR/props.d"/*; do
		[[ -f "$f" && "${f##*/}" != "$COMPOSER_PROPS" ]] || continue
		echo "wrap.${f##*/}=LD_PRELOAD=/data/wgapps/props.so WGP=${f##*/}"
	done
}

mount_app_props() {
	[[ -f "$BASE/lib/$APP_PROPS" ]] || return 0
	mkdir -p "$RUNDIR/props.d"
	bind "$BASE/lib/$APP_PROPS" /data/wgapps/props.so ro
	bind "$RUNDIR/props.d" /data/wgapps/props.d ro
}

# Set the wrap property in the running Android, when it was started with the
# library (otherwise the app would be told to load a file that is not there).
app_apply_live() { # package
	local pkg="$1" value=""
	if ! running; then
		log "saved; applies the next time Android starts"
		return 0
	fi
	if ! asys '[ -f /data/wgapps/props.so ]' 2>/dev/null; then
		log "saved; restart Android to enable per-app overrides"
		return 0
	fi
	if [[ -f "$RUNDIR/props.d/$pkg" ]]; then
		value="LD_PRELOAD=/data/wgapps/props.so WGP=$pkg"
	fi
	asys "setprop wrap.$pkg '$value'"
	log "applies the next time $pkg starts (stop it now with: wgapps sh am force-stop $pkg)"
}

# The device-profile screen in Android's Settings (settings-app/) reads and
# writes this file in the folder shared with Android; wgapps-profiles notices a
# change and runs `app import` on it. The host mirrors $APPS_CONF to it after
# every change of its own so the screen shows the truth.
PROFILES_FILE="$SHARE/device-profiles.conf"
APPS_ARCHIVE=WgappsSettings.apk

export_profiles() {
	local tmp="$SHARE/.device-profiles.conf.new"
	mkdir -p "$SHARE"
	if [[ -f "$APPS_CONF" ]]; then cp "$APPS_CONF" "$tmp"; else : >"$tmp"; fi
	chmod 0644 "$tmp"
	mv -f "$tmp" "$PROFILES_FILE"
	export_kinds
	export_mode
}

# The mode (steam or vr) is mirrored for the "Steam Frame mode" screen the same way.
MODE_FILE="$SHARE/app-mode.conf"

export_mode() {
	local tmp="$SHARE/.app-mode.conf.new"
	mkdir -p "$SHARE"
	mode_saved >"$tmp"
	chmod 0644 "$tmp"
	mv -f "$tmp" "$MODE_FILE"
}

# The launch type per app ($APPS_KIND) is mirrored the same way, for the same screen.
KINDS_FILE="$SHARE/app-kinds.conf"

export_kinds() {
	local tmp="$SHARE/.app-kinds.conf.new"
	mkdir -p "$SHARE"
	if [[ -f "$APPS_KIND" ]]; then cp "$APPS_KIND" "$tmp"; else : >"$tmp"; fi
	chmod 0644 "$tmp"
	mv -f "$tmp" "$KINDS_FILE"
}

# The valid lines of a file, one per package and key (the last wins), on stdout.
app_valid_lines() { # file
	local line pkg rest key value
	while IFS= read -r line || [[ -n "$line" ]]; do
		pkg="${line%% *}"
		rest="${line#* }"
		key="${rest%%=*}"
		value="${rest#*=}"
		if [[ "$line" == *" "* && "$rest" == *=* ]] && app_valid_package "$pkg" &&
			app_valid_key "$key" && app_valid_value "$value"; then
			printf '%s\n' "$line"
		fi
	done <"$1" | awk '{
		rest = substr($0, length($1) + 2)
		k = $1 " " substr(rest, 1, index(rest, "=") - 1)
		seen[k] = NR; text[NR] = $0; kk[NR] = k
	} END { for (i = 1; i <= NR; i++) if (seen[kk[i]] == i) print text[i] }'
}

# The lines of a file that belong to a package (exact match: "." is not a wildcard).
app_lines_of() { # file package
	local line
	[[ -f "$1" ]] || return 0
	while IFS= read -r line || [[ -n "$line" ]]; do
		if [[ "$line" == "$2 "* ]]; then printf '%s\n' "$line"; fi
	done <"$1"
}

app_import() { # file
	local file="$1" tmp="$APPS_CONF.new" size pkg old new
	[[ -f "$file" ]] || die "no such file: $file"
	size="$(wc -c <"$file")"
	((size <= 65536)) || die "$file is too big to be a list of overrides"
	if [[ "$(tr -d '\0' <"$file" | wc -c)" != "$size" ]]; then
		die "$file is not text"
	fi
	app_valid_lines "$file" >"$tmp"
	old="$(cut -d' ' -f1 "$APPS_CONF" 2>/dev/null | sort -u || true)"
	new="$(cut -d' ' -f1 "$tmp" | sort -u)"
	local changed=()
	for pkg in $(printf '%s\n%s\n' "$old" "$new" | sort -u); do
		if [[ "$(app_lines_of "$APPS_CONF" "$pkg")" != "$(app_lines_of "$tmp" "$pkg")" ]]; then
			changed+=("$pkg")
		fi
	done
	mv "$tmp" "$APPS_CONF"
	generate_app_props
	export_profiles
	for pkg in ${changed[@]+"${changed[@]}"}; do app_apply_live "$pkg"; done
	log "imported ${#changed[@]} changed package(s) from $file"
}

# Android's Settings lists extra screens only from system apps, so ours is
# mounted into /system/priv-app (settings-app/, built by
# tools/build-settings-app.sh). Not without the file.
mount_settings_app() {
	[[ -f "$BASE/lib/$APPS_ARCHIVE" ]] || return 0
	bind "$BASE/lib/$APPS_ARCHIVE" "/system/priv-app/${APPS_ARCHIVE%.apk}/$APPS_ARCHIVE" ro
}

cmd_app() {
	local action="${1:-}" pkg key value
	shift || true
	case "$action" in
	set)
		[[ $# -eq 3 ]] || die "usage: wgapps app set <package> <key> <value>"
		pkg="$1" key="$2" value="$3"
		app_valid_package "$pkg" || die "not a package name of at most 54 characters: $pkg"
		app_valid_key "$key" || die "unknown key '$key' (keys: ${APP_KEYS[*]})"
		app_valid_value "$value" ||
			die "value must be 1-91 characters of letters, digits, spaces and . _ + ( ) / : - (no leading or trailing space)"
		app_conf_rewrite "$pkg" "$key" "$value"
		generate_app_props
		export_profiles
		app_apply_live "$pkg"
		;;
	unset)
		[[ $# -ge 1 && $# -le 2 ]] || die "usage: wgapps app unset <package> [key]"
		pkg="$1" key="${2:-}"
		app_valid_package "$pkg" || die "not a package name of at most 54 characters: $pkg"
		if [[ -n "$key" ]]; then
			app_valid_key "$key" || die "unknown key '$key' (keys: ${APP_KEYS[*]})"
		fi
		app_conf_rewrite "$pkg" "$key" ""
		generate_app_props
		export_profiles
		app_apply_live "$pkg"
		;;
	import)
		[[ $# -eq 1 ]] || die "usage: wgapps app import <file>"
		app_import "$1"
		;;
	list)
		if [[ -s "$APPS_CONF" ]]; then
			cat "$APPS_CONF"
		else
			echo "no per-app overrides (wgapps app set <package> <key> <value>)"
		fi
		;;
	*) die "usage: wgapps app set|unset|list ..." ;;
	esac
}

# --- GLES implementation -----------------------------------------------------
# `mesa` (default): Mesa's own EGL/GLES on Turnip's Vulkan; `angle`: ANGLE (GLES on top of the
# same Vulkan driver). Anything but the word "angle" in $BASE/gpu-egl means mesa. Applies at start.
gpu_egl() {
	local mode=""
	[[ -f "$BASE/gpu-egl" ]] && read -r mode <"$BASE/gpu-egl" || true
	if [[ "$mode" == "angle" ]]; then echo angle; else echo mesa; fi
}

cmd_gpu() {
	local what="${1:-}" mode="${2:-}"
	[[ "$what" == "egl" ]] || die "usage: wgapps gpu egl [mesa|angle]"
	if [[ $# -eq 1 ]]; then
		gpu_egl
		return 0
	fi
	[[ $# -eq 2 && ("$mode" == "mesa" || "$mode" == "angle") ]] || die "usage: wgapps gpu egl [mesa|angle]"
	mkdir -p "$BASE"
	if [[ "$mode" == "mesa" ]]; then rm -f "$BASE/gpu-egl"; else echo "$mode" >"$BASE/gpu-egl"; fi
	if running; then log "$mode saved; restart Android for it to apply"; else log "$mode saved"; fi
}

# --- OpenXR render resolution ----------------------------------------------
# SteamVR recommends rendering at 80% of the Frame's panel in each direction (1728 of 2160
# pixels); apps follow it, so everything is upscaled. The OpenXR layer multiplies the
# recommendation by debug.xr.render_scale; 1.25 gives the panel size. $BASE/xr-scale holds
# an override and is not touched by update/rollback.
XR_SCALE_DEFAULT=1.25

# The scale as a percentage (100 to 200) when it is a plain decimal such as 1.25, else fails.
xr_scale_percent() {
	local frac whole
	[[ "$1" =~ ^([12])(\.([0-9]{1,2}))?$ ]] || return 1
	whole="${BASH_REMATCH[1]}"
	frac="${BASH_REMATCH[3]:-0}"
	[[ ${#frac} -eq 1 ]] && frac="${frac}0"
	((whole * 100 + 10#$frac >= 100 && whole * 100 + 10#$frac <= 200)) || return 1
	echo $((whole * 100 + 10#$frac))
}

xr_scale() {
	local value=""
	[[ -f "$BASE/xr-scale" ]] && read -r value <"$BASE/xr-scale" || true
	if xr_scale_percent "$value" >/dev/null 2>&1; then echo "$value"; else echo "$XR_SCALE_DEFAULT"; fi
}

# --- shared folders ---------------------------------------------------------
# Folders of this computer inside Android's own storage, where the Files app lists them. ~/Android-share is
# always shared, read-write, as "Host". `wgapps share add` adds others (any directory, your home included),
# read-only unless asked otherwise; each is recorded in $BASE/shares.conf as "name<TAB>path<TAB>ro|rw" and
# mounted at /data/media/0/<name> when Android starts.
SHARES_CONF="$BASE/shares.conf"
SHARE_DEFAULT_NAME=Host
SHARE_DEFAULT_DIR="$HOME/Android-share"
# Names Android's storage already uses (a mount there would hide the real folder).
SHARE_RESERVED=(Android Alarms Audiobooks DCIM Documents Download Movies Music Notifications Pictures Podcasts
	Recordings Ringtones)

share_valid_name() {
	local reserved lower
	[[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,31}$ ]] || return 1
	lower="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')"
	for reserved in "${SHARE_RESERVED[@]}"; do
		[[ "$lower" == "$(printf '%s' "$reserved" | tr '[:upper:]' '[:lower:]')" ]] && return 1
	done
	return 0
}

# A directory that may be shared: absolute, no characters that would break the mount option, not / and not
# wgapps' own data ($BASE and below: Android's file system and its apps' data). Your home may be shared:
# Android's apps run as other user IDs, so they see only what is readable by others.
share_valid_path() {
	[[ "$1" == /* && -d "$1" && "$1" != *[,:\\$'\n']* ]] || return 1
	local real base
	real="$(cd "$1" && pwd -P)" || return 1
	base="$(cd "$BASE" 2>/dev/null && pwd -P)" || base="$BASE"
	[[ "$real" == / || "$real" == "$base" || "$real" == "$base"/* ]] && return 1
	return 0
}

share_has() { # name
	[[ -f "$SHARES_CONF" ]] && awk -F'\t' -v n="$1" '$1 == n { found = 1 } END { exit !found }' "$SHARES_CONF"
}

# name<TAB>path<TAB>mode, the default folder first.
shares_list() {
	local name path mode
	printf '%s\t%s\trw\n' "$SHARE_DEFAULT_NAME" "$SHARE_DEFAULT_DIR"
	[[ -f "$SHARES_CONF" ]] || return 0
	while IFS=$'\t' read -r name path mode || [[ -n "$name" ]]; do
		if [[ "$name" != "$SHARE_DEFAULT_NAME" && ("$mode" == ro || "$mode" == rw) ]] &&
			share_valid_name "$name" && [[ -d "$path" ]]; then
			printf '%s\t%s\t%s\n' "$name" "$path" "$mode"
		fi
	done <"$SHARES_CONF"
}

# Android's apps reach a shared folder as group media_rw (gid 1023 inside the container, a sub-GID here).
share_group_id() {
	local probe gid=""
	command -v podman >/dev/null || return 1
	probe="$(mktemp "$BASE/.share-gid.XXXXXX")" || return 1
	# shellcheck disable=SC2012 # stat's format option differs between GNU and BSD; ls -n is the same everywhere
	if podman unshare chgrp 1023 "$probe" 2>/dev/null; then gid="$(ls -ldn "$probe" | awk '{ print $4 }')"; fi
	rm -f "$probe"
	[[ "$gid" =~ ^[0-9]+$ ]] && echo "$gid"
}

# Android's apps are other users than you, so a folder is open to them only as far as its permissions say
# (your home directory is mode 0700: closed). Sharing a folder therefore adds the media_rw group to the
# folder's own ACL, and nothing else: read and list for a read-only share; read, write and the same for what
# is created in it later for a read-write one. The built-in folder also belongs to the group (setgid), so
# what Android makes there stays shared; a folder you added keeps its owner and mode. Android still sees
# only what other users may read below the top level (a mode 0700 folder stays closed). `share remove`
# takes the entries away again.
share_prepare() { # folder builtin|added ro|rw
	local dir="$1" gid
	gid="$(share_group_id)" || return 0
	command -v setfacl >/dev/null || return 0
	if [[ "$3" == rw ]]; then
		if [[ "$2" == builtin ]]; then
			podman unshare chgrp 1023 "$dir" 2>/dev/null || true
			chmod 2775 "$dir" 2>/dev/null || true
		fi
		setfacl -m "g:$gid:rwx" -d -m "g:$gid:rwx" "$dir" 2>/dev/null || true
	else
		setfacl -m "g:$gid:rx" "$dir" 2>/dev/null || true
	fi
}

share_unprepare() { # folder
	local dir="$1" gid
	gid="$(share_group_id)" || return 0
	command -v setfacl >/dev/null || return 0
	setfacl -x "g:$gid" "$dir" 2>/dev/null || true
	setfacl -d -x "g:$gid" "$dir" 2>/dev/null || true
}

# Android reaches /storage/emulated (the Files app) through a FUSE layer that reads /mnt/pass_through, a
# copy of /data/media that vold makes late in boot (after boot_completed, so a bind made earlier would be
# covered) and that does not contain our mounts. So a small service waits for that mount and then binds
# each folder into it.
shares_script() {
	local name path mode
	cat <<'EOF'
#!/system/bin/sh
# wgapps: bind each shared folder where Android's FUSE storage layer reads it.
n=0
while ! grep -q ' /mnt/pass_through/0/emulated ' /proc/mounts; do
    n=$((n + 1))
    [ "$n" -gt 600 ] && exit 1
    sleep 1
done
bind_share() {
    grep -q " /mnt/pass_through/0/emulated/0/$1 " /proc/mounts ||
        mount -o bind "/data/media/0/$1" "/mnt/pass_through/0/emulated/0/$1"
}
EOF
	while IFS=$'\t' read -r name path mode; do
		printf 'bind_share %s\n' "$name"
	done < <(shares_list)
}

shares_init_rc() {
	cat <<'EOF'
service wgapps-shares /system/bin/sh /vendor/bin/wgapps-shares.sh
    user root
    group root
    disabled
    oneshot

on property:sys.boot_completed=1
    start wgapps-shares
EOF
}

mount_shares() {
	local name path mode
	mkdir -p "$SHARE_DEFAULT_DIR" "$RUNDIR"
	while IFS=$'\t' read -r name path mode; do
		bind "$path" "/data/media/0/$name" "$mode"
		share_prepare "$path" "$([[ "$name" == "$SHARE_DEFAULT_NAME" ]] && echo builtin || echo added)" "$mode"
	done < <(shares_list)
	shares_init_rc >"$RUNDIR/wgapps-shares.rc"
	shares_script >"$RUNDIR/wgapps-shares.sh"
	chmod 0644 "$RUNDIR/wgapps-shares.rc" "$RUNDIR/wgapps-shares.sh"
	bind "$RUNDIR/wgapps-shares.rc" /vendor/etc/init/wgapps-shares.rc ro
	bind "$RUNDIR/wgapps-shares.sh" /vendor/bin/wgapps-shares.sh ro
}

cmd_share() {
	local action="${1:-}" path name mode=ro arg
	shift || true
	case "$action" in
	"")
		while IFS=$'\t' read -r name path mode; do
			printf '%s\t%s\t%s\n' "$name" "$path" "$mode"
		done < <(shares_list)
		;;
	add)
		local args=()
		for arg in "$@"; do
			if [[ "$arg" == --rw ]]; then mode=rw; else args+=("$arg"); fi
		done
		[[ ${#args[@]} -ge 1 && ${#args[@]} -le 2 ]] || die "usage: wgapps share add <path> [name] [--rw]"
		path="${args[0]}"
		[[ "$path" == /* ]] || path="$PWD/$path"
		path="$(cd "$path" 2>/dev/null && pwd -P)" || die "not a directory: ${args[0]}"
		share_valid_path "$path" || die "cannot share $path (it must be a plain directory, not wgapps' own data)"
		name="${args[1]:-$(basename "$path")}"
		name="$(printf '%s' "$name" | tr -c 'A-Za-z0-9._-' '-' | sed 's/^[^A-Za-z0-9]*//')"
		[[ -n "$name" ]] || name=Folder
		share_valid_name "$name" || die "'$name' cannot be a folder name in Android's storage (letters, digits . _ - ; not one Android already uses)"
		[[ "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" == "$(printf '%s' "$SHARE_DEFAULT_NAME" | tr '[:upper:]' '[:lower:]')" ]] &&
			die "'$name' is the built-in folder (~/Android-share)"
		mkdir -p "$BASE"
		{
			if [[ -f "$SHARES_CONF" ]]; then awk -F'\t' -v n="$name" '$1 != n' "$SHARES_CONF"; fi
			printf '%s\t%s\t%s\n' "$name" "$path" "$mode"
		} >"$SHARES_CONF.new"
		mv "$SHARES_CONF.new" "$SHARES_CONF"
		log "$path shared as '$name' ($mode)$(running && echo "; restart Android for it to apply")"
		;;
	remove)
		[[ $# -eq 1 ]] || die "usage: wgapps share remove <name>"
		[[ "$1" != "$SHARE_DEFAULT_NAME" ]] || die "'$1' is the built-in folder (~/Android-share); it is always shared"
		share_has "$1" || die "no shared folder named '$1'"
		share_unprepare "$(awk -F'\t' -v n="$1" '$1 == n { print $2 }' "$SHARES_CONF")"
		awk -F'\t' -v n="$1" '$1 != n' "$SHARES_CONF" >"$SHARES_CONF.new"
		mv "$SHARES_CONF.new" "$SHARES_CONF"
		log "'$1' removed$(running && echo "; restart Android for it to apply")"
		;;
	*) die "usage: wgapps share [add <path> [name] [--rw]|remove <name>]" ;;
	esac
}

cmd_xr() {
	local value="${2:-}"
	[[ "${1:-}" == "scale" && $# -le 2 ]] || die "usage: wgapps xr scale [1.0-2.0|default]"
	if [[ $# -eq 1 ]]; then
		xr_scale
		return 0
	fi
	if [[ "$value" == "default" ]]; then
		rm -f "$BASE/xr-scale"
	else
		xr_scale_percent "$value" >/dev/null || die "xr scale must be a number from 1.0 to 2.0 (got '$value')"
		mkdir -p "$BASE"
		echo "$value" >"$BASE/xr-scale"
	fi
	if running; then log "xr scale $(xr_scale) saved; restart Android for it to apply"; else log "xr scale $(xr_scale) saved"; fi
}

# --- window mode -----------------------------------------------------------
# `floating`: apps open as movable windows inside Android's one panel (Android's own
# multi-window mode); `single` (default): each app fills the panel. $BASE/windows is
# not touched by update/rollback, and anything but the word "floating" means single.
windows_mode() {
	local mode=""
	[[ -f "$BASE/windows" ]] && read -r mode <"$BASE/windows" || true
	if [[ "$mode" == "floating" ]]; then echo floating; else echo single; fi
}

# Mode: steam (every app a Steam entry, Android as one flat panel; the default)
# or vr (the optional shell app is Android's home). The
# 3D home is a setting of vr mode, never a mode of its own. `update` and
# `rollback` leave $BASE/mode and $BASE/mode.conf alone.
# The shell app: the Rust build on the Starforge engine (StarforgeShell.apk) when
# it is installed, else the Java one (WgappsShell.apk). First found wins.
SHELL_APKS=(StarforgeShell.apk WgappsShell.apk)
SHELL_MAX_FAILS=3

# The installed shell's file name, empty when there is none.
shell_apk() {
	local apk
	for apk in "${SHELL_APKS[@]}"; do
		if [[ -f "$BASE/lib/$apk" ]]; then
			echo "$apk"
			return 0
		fi
	done
}

mode_saved() {
	local mode=""
	[[ -f "$BASE/mode" ]] && read -r mode <"$BASE/mode" || true
	if [[ "$mode" == "vr" ]]; then echo vr; else echo steam; fi
}

mode_home() {
	local line value=off
	if [[ -f "$BASE/mode.conf" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			[[ "$line" == "home=on" ]] && value=on
			[[ "$line" == "home=off" ]] && value=off
		done <"$BASE/mode.conf"
	fi
	echo "$value"
}

# mode.conf holds `home=on|off` and `env=<environment>`; setting one keeps the other.
mode_conf_get() { # key
	local line
	[[ -f "$BASE/mode.conf" ]] || return 0
	while IFS= read -r line || [[ -n "$line" ]]; do
		if [[ "$line" == "$1="* ]]; then echo "${line#*=}"; fi
	done <"$BASE/mode.conf" | tail -n 1
	return 0
}

mode_conf_set() { # key value
	local key="$1" value="$2" line tmp
	mkdir -p "$BASE"
	tmp="$(mktemp "$BASE/mode.conf.XXXXXX")"
	if [[ -f "$BASE/mode.conf" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			if [[ "$line" != "$key="* ]]; then echo "$line"; fi
		done <"$BASE/mode.conf" >>"$tmp"
	fi
	echo "$key=$value" >>"$tmp"
	mv "$tmp" "$BASE/mode.conf"
}

# What the shell shows behind its panels: `room` (SteamVR's view of the room), `home` (a 3D
# space the shell draws), `solid`, or `solid #rrggbb`. The same words the shell parses (xr-pointer's environment module).
env_valid() {
	[[ "$1" == room || "$1" == home || "$1" == solid || "$1" =~ ^solid\ \#[0-9A-Fa-f]{6}$ ]]
}

mode_env() {
	local value
	value="$(mode_conf_get env)" || value=""
	if env_valid "$value"; then echo "$value"; else echo room; fi
}

# The mode that applies at the next start: vr only while the shell is installed.
mode_effective() {
	if [[ "$(mode_saved)" == "vr" && -n "$(shell_apk)" ]]; then echo vr; else echo steam; fi
}

# The shell reports how it started; after SHELL_MAX_FAILS failures in a row the
# saved mode goes back to steam so the Frame is never stuck without a launcher.
mode_record_start() { # ok|fail
	local file="$RUNDIR/shell-fails" fails=0
	mkdir -p "$RUNDIR"
	[[ -f "$file" ]] && read -r fails <"$file" || true
	if [[ "$1" == "ok" ]]; then
		rm -f "$file"
		return 0
	fi
	fails=$((fails + 1))
	echo "$fails" >"$file"
	if ((fails >= SHELL_MAX_FAILS)); then
		echo steam >"$BASE/mode"
		rm -f "$file"
		log "the VR shell failed to start $SHELL_MAX_FAILS times: back to steam mode"
	fi
}

mount_shell_app() {
	[[ "$(mode_effective)" == "vr" ]] || return 0
	local apk
	apk="$(shell_apk)"
	bind "$BASE/lib/$apk" "/system/priv-app/${apk%.apk}/$apk" ro
}

cmd_mode() {
	local want="${1:-}"
	case "$want" in
	"")
		echo "$(mode_saved) (home $(mode_home))"
		;;
	steam)
		mkdir -p "$BASE"
		echo steam >"$BASE/mode"
		export_mode
		log "steam mode saved$(running && echo "; restart Android for it to apply")"
		;;
	vr)
		[[ -n "$(shell_apk)" ]] ||
			die "VR mode needs a shell app ($BASE/lib/StarforgeShell.apk or WgappsShell.apk), which is not installed; staying in steam mode"
		mkdir -p "$BASE"
		echo vr >"$BASE/mode"
		export_mode
		log "vr mode saved$(running && echo "; restart Android for it to apply")"
		;;
	import)
		# What the Settings screen wrote (see wgapps-profiles): one word. A mode the host refuses
		# (vr without the shell) is mirrored back as it was, so the screen snaps back.
		[[ $# -eq 2 && -f "$2" ]] || die "usage: wgapps mode import <file>"
		(($(wc -c <"$2") <= 64)) || die "$2 is too big to be a mode"
		read -r want <"$2" || true
		[[ "$want" == steam || "$want" == vr ]] || {
			export_mode
			die "not a mode: $want"
		}
		(cmd_mode "$want") || {
			export_mode
			return 1
		}
		;;
	home)
		case "${2:-}" in
		"") mode_home ;;
		on | off)
			mode_conf_set home "$2"
			log "home $2 saved"
			;;
		*) die "usage: wgapps mode home on|off" ;;
		esac
		;;
	env)
		shift
		if [[ $# -eq 0 ]]; then
			mode_env
		else
			local value="$*"
			env_valid "$value" || die "usage: wgapps mode env room|home|solid [#rrggbb]"
			mode_conf_set env "$value"
			log "environment '$value' saved$(running && echo "; restart the VR shell for it to apply")"
		fi
		;;
	*) die "usage: wgapps mode [steam|vr|import <file>|home [on|off]|env [room|home|solid [#rrggbb]]]" ;;
	esac
}

cmd_windows() {
	local mode="${1:-}"
	if [[ $# -eq 0 ]]; then
		windows_mode
		return 0
	fi
	[[ $# -eq 1 && ("$mode" == "floating" || "$mode" == "single") ]] ||
		die "usage: wgapps windows floating|single"
	mkdir -p "$BASE"
	echo "$mode" >"$BASE/windows"
	if running; then
		log "$mode saved; restart Android for it to apply"
	else
		log "$mode saved"
	fi
}

# --- app catalog ---------------------------------------------------------
# What the user can open, one line per app: package<TAB>label<TAB>activity<TAB>kind.
# Android's command line gives components but no label text, so labels come from
# $SHARE/app-labels.conf (package<TAB>label, written by the Settings app) and fall
# back to the capitalised last part of the package. kind is xr when the launcher
# component itself declares org.khronos.openxr.intent.category.IMMERSIVE_HMD
# (Chrome lists a WebXR host activity there that is not its launcher entry).
APPS_LABELS="$SHARE/app-labels.conf"
APPS_HIDDEN="$BASE/apps-hidden"
APPS_KIND="$BASE/apps-kind"
APPS_HIDDEN_DEFAULT="com.android.launcher3 com.android.documentsui com.google.android.googlequicksearchbox dev.wgapps.settings dev.wgapps.shell rs.starforge.xrhost"

catalog_build() {
	local launcher="$1" xr="$2" labels hidden kinds
	labels="$APPS_LABELS"
	hidden="$APPS_HIDDEN"
	kinds="$APPS_KIND"
	[[ -f "$labels" ]] || labels=/dev/null
	[[ -f "$hidden" ]] || hidden=/dev/null
	[[ -f "$kinds" ]] || kinds=/dev/null
	LC_ALL=C awk -v hidden_default="$APPS_HIDDEN_DEFAULT" '
		function clean(s) { gsub(/\r/, "", s); gsub(/[\001-\037\177]/, "", s); return s }
		BEGIN {
			n = split(hidden_default, parts, " ")
			for (i = 1; i <= n; i++) skip[parts[i]] = 1
		}
		file == 1 { # labels
			line = $0; gsub(/\r/, "", line)
			tab = index(line, "\t")
			if (tab < 2) next
			pkg = substr(line, 1, tab - 1); text = substr(line, tab + 1)
			gsub(/\t/, " ", text); text = clean(text)
			if (text != "") label[pkg] = text
			next
		}
		file == 2 { # hidden
			line = clean($0); sub(/^ +/, "", line); sub(/ +$/, "", line)
			if (line != "" && substr(line, 1, 1) != "#") skip[line] = 1
			next
		}
		file == 3 { # xr components
			line = clean($0); sub(/^ +/, "", line); sub(/ +$/, "", line)
			if (line ~ /^[^ \/]+\/[^ ]+$/) xr[line] = 1
			next
		}
		file == 4 { # kind chosen by the user: "<package> xr|2d"
			if (NF == 2 && ($2 == "xr" || $2 == "2d")) forced[$1] = $2
			next
		}
		{ # launcher components
			line = clean($0); sub(/^ +/, "", line); sub(/ +$/, "", line)
			if (line !~ /^[^ \/]+\/[^ ]+$/) next
			slash = index(line, "/")
			pkg = substr(line, 1, slash - 1); activity = substr(line, slash + 1)
			if (pkg !~ /^[A-Za-z][A-Za-z0-9_]*(\.[A-Za-z0-9_]+)+$/ || length(pkg) > 54) next
			if (activity !~ /^[A-Za-z0-9_.$]+$/) next
			if ((pkg in seen) || (pkg in skip)) next
			seen[pkg] = 1
			name = (pkg in label) ? label[pkg] : ""
			if (name == "") {
				m = split(pkg, bits, ".")
				name = toupper(substr(bits[m], 1, 1)) substr(bits[m], 2)
			}
			kind = (line in xr) ? "xr" : "2d"
			if (pkg in forced) kind = forced[pkg]
			printf "%s\t%s\t%s\t%s\n", pkg, name, line, kind
		}
	' file=1 "$labels" file=2 "$hidden" file=3 "$xr" file=4 "$kinds" file=5 "$launcher" | LC_ALL=C sort -t "$(printf '\t')" -k2,2f -k1,1
}

# Ask the Settings app to rewrite app-labels.conf (it can read the apps' names; the
# command line cannot) and wait for the new file, 0.1 s at a time. If it does not
# answer, the previous file stays. Not without the app.
catalog_refresh_labels() {
	[[ -f "$BASE/lib/$APPS_ARCHIVE" ]] || return 0
	local old="$APPS_LABELS.prev" tries
	if [[ -f "$APPS_LABELS" ]]; then mv -f "$APPS_LABELS" "$old"; fi
	asys "am broadcast -n dev.wgapps.settings/.LabelsReceiver" >/dev/null 2>&1 || true
	for ((tries = 0; tries < ${WGAPPS_LABEL_TRIES:-50}; tries++)); do
		[[ -f "$APPS_LABELS" ]] && break
		sleep 0.1
	done
	if [[ -f "$APPS_LABELS" ]]; then
		rm -f "$old"
	elif [[ -f "$old" ]]; then
		mv -f "$old" "$APPS_LABELS"
	fi
}

apps_kind_set() { # package kind
	local tmp="$APPS_KIND.new" line
	: >"$tmp"
	if [[ -f "$APPS_KIND" ]]; then
		while IFS= read -r line || [[ -n "$line" ]]; do
			[[ "$line" == "$1 "* ]] || printf '%s\n' "$line" >>"$tmp"
		done <"$APPS_KIND"
	fi
	if [[ "$2" != auto ]]; then printf '%s %s\n' "$1" "$2" >>"$tmp"; fi
	mv "$tmp" "$APPS_KIND"
	export_kinds
}

# Take over the file the Settings screen wrote: "<package> xr|2d" lines. Lines that are not
# valid are dropped, the last line of a package wins, and a file that is too big or not text
# is refused whole.
apps_kind_import() { # file
	local file="$1" size line pkg kind tmp="$APPS_KIND.new"
	[[ -f "$file" ]] || die "no such file: $file"
	size="$(wc -c <"$file")"
	((size <= 65536)) || die "$file is too big to be a list of launch types"
	if [[ "$(tr -d '\0' <"$file" | wc -c)" != "$size" ]]; then
		die "$file is not text"
	fi
	while IFS= read -r line || [[ -n "$line" ]]; do
		pkg="${line%% *}"
		kind="${line#* }"
		if [[ "$line" == *" "* ]] && app_valid_package "$pkg" && [[ "$kind" == xr || "$kind" == 2d ]]; then
			printf '%s %s\n' "$pkg" "$kind"
		fi
	done <"$file" | awk '{ seen[$1] = NR; text[NR] = $0; key[NR] = $1 }
		END { for (i = 1; i <= NR; i++) if (seen[key[i]] == i) print text[i] }' >"$tmp"
	mv "$tmp" "$APPS_KIND"
}

cmd_apps() {
	local action="${1:-}" launcher xr catalog status
	shift || true
	case "$action" in
	list)
		running || die "Android is not running (wgapps start)"
		catalog_refresh_labels
		launcher="$(mktemp)" xr="$(mktemp)"
		asys "cmd package query-activities --brief -a android.intent.action.MAIN -c android.intent.category.LAUNCHER" |
			tr -d '\r' >"$launcher" || true
		asys "cmd package query-activities --brief -a android.intent.action.MAIN -c org.khronos.openxr.intent.category.IMMERSIVE_HMD" |
			tr -d '\r' >"$xr" || true
		catalog_build "$launcher" "$xr"
		rm -f "$launcher" "$xr"
		;;
	push)
		# The app list for the VR shell, in the folder shared with Android.
		running || die "Android is not running (wgapps start)"
		catalog="$(mktemp)"
		cmd_apps list >"$catalog" || {
			rm -f "$catalog"
			return 1
		}
		mkdir -p "$SHARE"
		chmod 0644 "$catalog"
		mv -f "$catalog" "$SHARE/apps.tsv"
		;;
	sync)
		# One Steam library entry per Android app (see steam-shortcuts.py sync).
		catalog="$(mktemp)"
		cmd_apps list >"$catalog" || {
			rm -f "$catalog"
			return 1
		}
		cut -f1,2 "$catalog" >"$catalog.tsv"
		python3 "$BIN/steam-shortcuts.py" sync "$catalog.tsv" || status=$?
		rm -f "$catalog" "$catalog.tsv"
		return "${status:-0}"
		;;
	kind)
		# How the app is treated: xr (an OpenXR app), 2d (a flat app) or auto (detected).
		[[ $# -eq 2 ]] || die "usage: wgapps apps kind <package> xr|2d|auto"
		app_valid_package "$1" || die "not a package name of at most 54 characters: $1"
		[[ "$2" == xr || "$2" == 2d || "$2" == auto ]] || die "kind must be xr, 2d or auto"
		apps_kind_set "$1" "$2"
		;;
	kind-import)
		# What the Settings screen's launch-type rows write (see wgapps-profiles).
		[[ $# -eq 1 ]] || die "usage: wgapps apps kind-import <file>"
		apps_kind_import "$1"
		;;
	*) die "usage: wgapps apps list|push|sync|kind|kind-import" ;;
	esac
}

# Runtime overrides: every file under overrides/ (from the release),
# overrides-generated/ (derived from the user's vendor image) and
# local-overrides/ (device-local files; never touched by updates) is
# bind-mounted read-only over the same path in Android. The extracted image
# is never modified. A file with a patched copy (composer_patched) is bound as
# that copy: podman refuses a second mount on the same destination.
bind_overrides() {
	local f dir src
	for dir in overrides overrides-generated local-overrides; do
		[[ -d "$BASE/$dir" ]] || continue
		while IFS= read -r -d '' f; do
			f="${f#./}"
			src="$BASE/$dir/$f"
			[[ -f "$(composer_patched "$f")" ]] && src="$(composer_patched "$f")"
			ARGS+=(--mount "type=bind,source=$src,destination=/$f,ro")
		done < <(cd "$BASE/$dir" && find . -type f -print0)
	done
}

# JSON string literal of $1 (backslashes and quotes escaped; the paths here have no control characters).
json_str() {
	local v="${1//\\/\\\\}"
	printf '"%s"' "${v//\"/\\\"}"
}

# The run specification the Rust launcher reads: headless, host DNS, output file, then the optional
# mounts ("--mount" value pairs from ARGS), "--", then the device nodes that exist.
write_run_spec() {
	local headless="$1" dns="$2" out="$3"
	shift 3
	local mounts=() devs=() part seen=false
	for part in "$@"; do
		if [[ "$part" == -- ]]; then
			seen=true
		elif [[ "$part" == --mount ]]; then
			:
		elif [[ "$seen" == true ]]; then
			devs+=("$part")
		else
			mounts+=("$part")
		fi
	done
	local list item sep
	{
		printf '{"name":%s,"data":%s,"share":%s,"rundir":%s,"rootfs":%s,"seccomp":%s,' \
			"$(json_str "$NAME")" "$(json_str "$DATA")" "$(json_str "$SHARE")" "$(json_str "$RUNDIR")" \
			"$(json_str "$ROOTFS")" "$(json_str "$RUNDIR/android.seccomp.json")"
		list="" sep=""
		for item in ${mounts[@]+"${mounts[@]}"}; do
			list+="$sep$(json_str "$item")"
			sep=","
		done
		printf '"extra_mounts":[%s],' "$list"
		list="" sep=""
		for item in ${devs[@]+"${devs[@]}"}; do
			list+="$sep$(json_str "$item")"
			sep=","
		done
		printf '"devices":[%s],' "$list"
		printf '"char_dev":%s,' "$([[ -e /dev/char ]] && echo true || echo false)"
		if [[ -e "$XDG/pulse/native" ]]; then
			printf '"pulse_socket":%s,' "$(json_str "$XDG/pulse/native")"
		else
			printf '"pulse_socket":null,'
		fi
		if [[ "$headless" != "true" ]]; then
			printf '"wayland_socket":%s,' "$(json_str "$WAYLAND_SOCKET")"
		else
			printf '"wayland_socket":null,'
		fi
		printf '"net_subnet":%s,"net_addr":%s,"host_dns":%s,"cgroups":"%s"}\n' \
			"$(json_str "$NET_SUBNET")" "$(json_str "$NET_ADDR")" "$(json_str "$dns")" \
			"$([[ "${WGAPPS_CGROUPS:-1}" == "0" ]] && echo disabled || echo enabled)"
	} >"$out"
}

cmd_start() {
	local headless=false
	[[ "${1:-}" == "--headless" ]] && headless=true
	[[ -d "$ROOTFS/system" ]] || die "no rootfs at $ROOTFS (run: wgapps prepare)"
	if running; then
		log "already running"
		return 0
	fi
	podman rm -f "$NAME" >/dev/null 2>&1 || true
	mkdir -p "$DATA" "$SHARE"
	# Android's apps write here too (the device-profile screen); every user ID
	# in the container is a sub-ID of ours.
	chmod 0777 "$SHARE"
	export_profiles
	ensure_idmap
	podman unshare "$0" _repair-keystore "$DATA/misc/keystore"
	generate_overrides
	generate_app_props
	write_props "$headless"

	# Hostname and hosts file as on stock Android: podman's generated
	# /etc/hosts would hide /system/etc/hosts and map the hostname to the
	# pasta address, so apps that bind "this device" (Plex's offline
	# download server) listen on 172.20.0.2 while clients dial localhost.
	ARGS=(
		run -d --replace --name "$NAME" --hostname localhost --no-hosts
		--env-host=false --init=false --env-file /dev/null
		"${IDMAP[@]}" --user 0:0 --group-add keep-groups
		--pid=private --ipc=private --uts=private --cgroupns=private
		--cap-drop ALL
	)
	# Cgroups: Android's process-state handling (foreground/background,
	# freezing) runs through libprocessgroup. WGAPPS_CGROUPS=0 restores
	# Lepton's --cgroups=disabled.
	if [[ "${WGAPPS_CGROUPS:-1}" == "0" ]]; then
		ARGS+=(--cgroups=disabled)
	else
		# Podman's default pids limit (2048) is below Android's thread count
		# during boot; thread creation then fails with EAGAIN. The user slice's
		# TasksMax still bounds the session.
		ARGS+=(--security-opt unmask=/sys/fs/cgroup --pids-limit=-1)
	fi
	local cap
	for cap in audit_control sys_nice wake_alarm setpcap setgid setuid sys_ptrace \
		sys_admin block_suspend sys_time net_admin net_raw net_bind_service kill \
		dac_override dac_read_search fsetid mknod syslog chown sys_resource fowner \
		ipc_lock sys_chroot; do
		ARGS+=(--cap-add "$cap")
	done
	# Our own profile, whatever Lepton ships (see write_seccomp). A copy of
	# Lepton's from an earlier install is not used and is removed.
	rm -f "$BASE/lepton.seccomp.json"
	ARGS+=(--security-opt "seccomp=$(write_seccomp)")
	# shellcheck disable=SC2054 # commas are mount options, not separators
	ARGS+=(
		--tmpfs /dev:rw,nosuid,U
		--tmpfs /dev/socket:rw,nosuid,noexec,mode=0755,U
		--tmpfs /tmp:rw,nosuid,nodev,noexec,U
		--tmpfs /var:rw,nosuid,nodev,noexec,U
		--tmpfs /run:rw,nosuid,nodev,noexec,U
		--tmpfs /waydroid/xdg
		# init remounts / read-only after early boot; Android needs /mnt writable
		# (stock Waydroid LXC mounts a tmpfs here too).
		--tmpfs /mnt:rw,nosuid,nodev,mode=0755,U
		--mount type=devpts,destination=/dev/pts,mode=644,ptmxmode=666
		--mount "type=bind,source=$DATA,destination=/data,rw"
		--mount "type=bind,source=$RUNDIR/waydroid.prop,destination=/vendor/waydroid.prop,ro"
		--mount "type=bind,source=$SHARE,destination=/data/local/tmp/host_share,rw"
	)
	local extras_from=${#ARGS[@]}
	prepare_composer_egl
	bind_overrides
	mount_xr
	mount_gbm_lock
	mount_egl_layer
	mount_hw_decode
	mount_app_props
	mount_composer_egl
	mount_settings_app
	mount_shell_app
	mount_shares
	local extra_mounts=("${ARGS[@]:extras_from}") devices_present=()
	local dev devices=(/dev/dri/card0 /dev/dri/renderD128 /dev/zero /dev/null /dev/full
		/dev/fuse /dev/tty /dev/shm /dev/snd /dev/uhid /dev/net/tun /dev/random
		/dev/urandom)
	[[ -n "${HW_DECODE_NODE:-}" ]] && devices+=("$HW_DECODE_NODE")
	for dev in "${devices[@]}"; do
		bind "$dev" "$dev" rw
		[[ -e "$dev" ]] && devices_present+=("$dev")
	done
	# Android init logs to /dev/kmsg; capture it in a file for debugging.
	: >"$RUNDIR/kmsg.log"
	bind "$RUNDIR/kmsg.log" /dev/kmsg rw
	bind /dev/char /dev/char rw
	bind "$XDG/pulse/native" /waydroid/xdg/pulse/native "rw,U"
	if [[ "$headless" != "true" ]]; then
		[[ -S "$WAYLAND_SOCKET" ]] || die "no Wayland socket at $WAYLAND_SOCKET"
		bind "$WAYLAND_SOCKET" /waydroid/xdg/wayland-0 "rw,U"
	fi
	# pasta on a private subnet like Lepton: pasta is the gateway on .1 and
	# forwards DNS sent there to the host resolver. Android configures eth0 via
	# pasta's DHCP, which advertises .1 as the DNS server (the host's own
	# resolver is a 127.0.0.53 stub Android cannot reach). Container ports
	# (adb) are forwarded to the host. --dns-host must be explicit: with -D set,
	# pasta otherwise forwards queries for .1 back to .1 and they time out.
	local host_dns
	host_dns="$(awk '/^nameserver/ { print $2; exit }' /etc/resolv.conf)"
	[[ -n "$host_dns" ]] || die "no nameserver in /etc/resolv.conf"
	ARGS+=(--network "pasta:-I,eth0,--ipv4-only,--no-ndp,-a,$NET_ADDR,-n,24,-g,$NET_SUBNET.1,-m,1500,--no-dhcpv6,--map-gw,--dns-forward,$NET_SUBNET.1,-D,$NET_SUBNET.1,--dhcp-dns,--dns-host,$host_dns,-t,auto,-u,auto")
	# Skip first-stage init (device nodes, mounts) as Waydroid does.
	ARGS+=(--rootfs "$ROOTFS:O" /system/bin/init second_stage)

	log "starting $NAME (headless=$headless)"
	if [[ -n "${WGAPPS_LAUNCHER:-}" ]]; then
		# The Rust launcher builds the same argument list from a specification (it is checked
		# against this script's list by tests) and runs podman. Opt-in while it is proven.
		write_run_spec "$headless" "$host_dns" "$RUNDIR/run-spec.json" \
			"${extra_mounts[@]+"${extra_mounts[@]}"}" -- "${devices_present[@]+"${devices_present[@]}"}"
		"$WGAPPS_LAUNCHER" start --spec "$RUNDIR/run-spec.json" >/dev/null
	else
		podman "${ARGS[@]}" >/dev/null
	fi
	start_helpers
}

# Host-side helpers that run alongside Android and stop with it:
#   wgapps-pad      Steam's virtual Xbox pad -> Android remote keys. Reaches
#                   Waydroid's keyboard FIFO through the container's /proc
#                   root. Do not mount /dev/input from the host: if it exists
#                   when Android's init starts, init's keychord watcher opens
#                   each new FIFO read-only and blocks forever (boot hangs).
#   wgapps-battery  the Frame's battery -> Android's BatteryService.
#   wgapps-clipboard  Android's clipboard <-> gamescope's X11 clipboard,
#                   served as Waydroid's clipboard HIDL service over the
#                   container's hwbinder (libgbinder from lib/).
start_helpers() {
	local pid
	stop_helpers
	pid="$(podman inspect -f '{{.State.Pid}}' "$NAME" 2>/dev/null || true)"
	[[ -n "$pid" && "$pid" != 0 ]] || return 0
	start_helper wgapps-pad "/proc/$pid/root/dev/input/wl_keyboard_events"
	start_helper wgapps-battery
	start_helper wgapps-clipboard
	WGAPPS_BASE="$BASE" WGAPPS_SHARE="$SHARE" WGAPPS_BIN="$BIN" start_helper wgapps-profiles
	WGAPPS_BASE="$BASE" start_helper wgapps-share
	# Taps from the VR shell onto a 2D app's panel; only in vr mode.
	if [[ "$(mode_effective)" == "vr" ]]; then
		WGAPPS_BASE="$BASE" WGAPPS_SHARE="$SHARE" start_helper wgapps-panelinput
		# The bridge to the shell: Steam games in its grid, launching them.
		WGAPPS_BASE="$BASE" WGAPPS_SHARE="$SHARE" start_helper wgapps-bridge
	fi
}

start_helper() {
	local name="$1"
	shift
	WGAPPS_CONTAINER="$NAME" setsid /usr/bin/python3 "$BIN/$name" "$@" \
		>>"$RUNDIR/$name.log" 2>&1 </dev/null &
	echo $! >"$RUNDIR/$name.pid"
}

stop_helpers() {
	local name pid
	for name in wgapps-pad wgapps-battery wgapps-clipboard wgapps-profiles wgapps-share wgapps-panelinput wgapps-bridge; do
		pid="$(cat "$RUNDIR/$name.pid" 2>/dev/null || true)"
		if [[ -n "$pid" ]] && grep -q "$name" "/proc/$pid/cmdline" 2>/dev/null; then
			kill "$pid" 2>/dev/null || true
		fi
		rm -f "$RUNDIR/$name.pid"
	done
}

cmd_stop() {
	if running; then
		asys "setprop sys.powerctl shutdown" 2>/dev/null || true
		podman wait --condition=stopped "$NAME" >/dev/null 2>&1 &
		local waiter=$!
		local i
		for i in $(seq 1 20); do
			running || break
			sleep 1
		done
		kill "$waiter" 2>/dev/null || true
	fi
	podman rm -f "$NAME" >/dev/null 2>&1 || true
	stop_helpers
	log "stopped"
}

boot_done() {
	[[ "$(asys 'getprop sys.boot_completed' 2>/dev/null | tr -d '\r')" == "1" ]]
}

cmd_wait_boot() {
	local timeout="${1:-180}" i
	for ((i = 0; i < timeout; i++)); do
		running || die "container exited during boot"
		boot_done && return 0
		sleep 1
	done
	die "boot not complete after ${timeout}s"
}

cmd_status() {
	if ! running; then
		echo "stopped"
		return 0
	fi
	echo "running"
	# shellcheck disable=SC2016 # expands inside Android
	asys 'echo "boot_completed=$(getprop sys.boot_completed) bootanim=$(getprop init.svc.bootanim) sf=$(getprop init.svc.surfaceflinger) zygote=$(getprop init.svc.zygote)"' 2>/dev/null || true
}

launcher_activity() {
	asys "cmd package resolve-activity --brief -a android.intent.action.MAIN -c android.intent.category.LAUNCHER '$1'" |
		tr -d '\r' | tail -n 1
}

cmd_launch() {
	local pkg="${1:?package required}" act
	if ! running; then
		cmd_start
	fi
	cmd_wait_boot 240
	act="$(launcher_activity "$pkg")"
	[[ "$act" == */* ]] || die "no launcher activity for $pkg"
	asys "am start -W -n '$act'" >/dev/null
	log "launched $act"
}

cmd_run() {
	local pkg="${1:?package required}"
	cmd_launch "$pkg"
	# Give the app a moment to create its process, then follow it until it exits.
	sleep 3
	while running && [[ -n "$(asys "pidof '$pkg'" 2>/dev/null | tr -d '\r')" ]]; do
		sleep 2
	done
	log "$pkg exited"
	if [[ "${WGAPPS_KEEP_RUNNING:-false}" != "true" ]]; then
		cmd_stop
	fi
}

# Steam launches shortcuts under `reaper SteamLaunch AppId=<id>`, and
# gamescope maps a Wayland client to a Steam app by walking the client's
# process ancestry to that reaper. conmon detaches and is re-parented to the
# reaper (a child subreaper), so the entry that STARTS Android owns the panel
# (focus, overlay, Quit) and has to be the one that starts it.
#
# Every later entry attaches: it runs its app in the container that is
# already up (`am start`), never restarts or stops it, and ends when its app
# has no process left (wgapps-appwatch), so Steam's "running" follows the app.
# Quitting an attached entry from Steam force-stops only its app. Quitting
# the owner stops Android, as it always did (the other apps go with it).
# VR mode: show the shell instead of Android's own home. The shell reports
# nothing itself; a running process is the sign it started, and
# mode_record_start counts failures (three in a row go back to steam mode).
SHELL_PACKAGE=dev.wgapps.shell
STARFORGE_SHELL_PACKAGE=rs.starforge.xrhost
STARFORGE_SHELL_ACTIVITY=rs.starforge.Activity

# SteamVR keeps the dashboard (the Android panel) in front of a freshly started
# scene app and the session stays VISIBLE, not FOCUSED, so the app gets no
# controller input. One hide is not enough: repeating it for a few seconds is
# what gets a session to FOCUSED (measured with the shell and hello_xr).
hide_dashboard() {
	local runtime vrcmd
	runtime="$(steamvr_dir "${WGAPPS_STEAMVR_RUNTIME:-}" path)"
	vrcmd="$runtime/bin/linuxarm64/vrcmd"
	[[ -x "$vrcmd" ]] || return 0
	LD_LIBRARY_PATH="$(dirname "$vrcmd")" "$vrcmd" --hidedashboard >/dev/null 2>&1 || true
}

shell_launch() {
	local tries activity package="$SHELL_PACKAGE"
	[[ "$(mode_effective)" == "vr" ]] || return 0
	cmd_apps push || log "could not write the app list for the shell"
	mkdir -p "$SHARE"
	# The backdrop the shell draws (the Rust shell reads it at start).
	mode_env >"$SHARE/environment.tmp" && chmod 0644 "$SHARE/environment.tmp" &&
		mv "$SHARE/environment.tmp" "$SHARE/environment" || true
	if [[ "$(shell_apk)" == StarforgeShell.apk ]]; then
		# The Rust shell is always an OpenXR scene.
		package="$STARFORGE_SHELL_PACKAGE"
		activity="$STARFORGE_SHELL_ACTIVITY"
	else
		# The OpenXR scene when the build had the native part (build-shell.sh
		# drops WgappsShell.vr next to the APK), else the flat grid.
		activity=.ShellActivity
		[[ -f "$BASE/lib/WgappsShell.vr" ]] && activity=.VrShellActivity
	fi
	asys "am start -n $package/$activity" >/dev/null 2>&1 || true
	for ((tries = 0; tries < ${WGAPPS_SHELL_TRIES:-20}; tries++)); do
		if [[ -n "$(asys "pidof $package" 2>/dev/null | tr -d '\r')" ]]; then
			# Keep asking for focus for a few seconds after the process is up.
			for _ in 1 2 3 4 5 6; do
				hide_dashboard
				sleep 2
			done
			mode_record_start ok
			return 0
		fi
		sleep 1
	done
	log "the VR shell did not start"
	mode_record_start fail
	return 1
}

# Toggle the running Android between the VR shell and the flat panel without restarting it:
# `panel` stops the Rust shell (Android's home shows on the flat panel), `vr` starts it again.
cmd_view() {
	case "${1:-}" in
	panel)
		running || die "Android is not running"
		asys "am force-stop $STARFORGE_SHELL_PACKAGE; input keyevent 3" >/dev/null
		log "panel view"
		;;
	vr)
		running || die "Android is not running"
		[[ "$(shell_apk)" == StarforgeShell.apk ]] || die "the Starforge VR shell is not installed"
		# SteamVR runs one scene app at a time per Steam app key: stop the VR apps still running,
		# or it refuses the shell's session.
		local xr_pkg
		while IFS=$'\t' read -r xr_pkg _ _ kind; do
			if [[ "$kind" == xr && "$xr_pkg" =~ ^[A-Za-z0-9_.]+$ ]]; then asys "am force-stop $xr_pkg" >/dev/null || true; fi
		done <"$SHARE/apps.tsv" 2>/dev/null || true
		asys "am start -n $STARFORGE_SHELL_PACKAGE/$STARFORGE_SHELL_ACTIVITY" >/dev/null
		hide_dashboard
		log "VR view"
		;;
	*) die "usage: wgapps view panel|vr" ;;
	esac
}

cmd_steam() {
	local pkg="${1:-}" act owner=false
	[[ -z "$pkg" ]] || app_valid_package "$pkg" || die "not a package name: $pkg"
	if running; then
		log "attaching to the running Android"
	else
		owner=true
		trap 'cmd_stop; exit 0' TERM INT HUP
		cmd_start
		cmd_wait_boot 240
	fi
	if [[ -n "$pkg" ]]; then
		act="$(launcher_activity "$pkg")"
		if [[ "$act" == */* ]]; then
			asys "am start -n '$act'" >/dev/null
		else
			log "no launcher activity for $pkg; showing the home screen"
			pkg=""
		fi
	fi
	if [[ -z "$pkg" ]]; then
		if [[ "$(mode_effective)" == "vr" ]]; then
			shell_launch || log "showing Android's home instead"
		elif [[ "$owner" != true ]]; then
			asys "am start -a android.intent.action.MAIN -c android.intent.category.HOME" >/dev/null
		fi
	fi
	if [[ "$owner" == true || -z "$pkg" ]]; then
		# The owner (and an entry with no app of its own) lives as long as Android.
		podman wait "$NAME" >/dev/null 2>&1 &
	else
		WGAPPS_CONTAINER="$NAME" python3 "$BIN/wgapps-appwatch" "$pkg" &
		# shellcheck disable=SC2064 # $pkg and the watcher's pid are fixed from here on
		trap "kill $! 2>/dev/null; asys \"am force-stop '$pkg'\" >/dev/null 2>&1 || true; exit 0" TERM INT HUP
	fi
	wait $! || true
	trap - TERM INT HUP
	log "${pkg:-Android} exited"
}

# --- install, update, uninstall -------------------------------------------

LEPTON_SECCOMP="$HOME/.local/share/Steam/steamapps/common/Lepton/liblepton/lepton.seccomp.json"

check_prereqs() {
	local bad=0 tool free
	[[ "$(uname -m)" == "aarch64" ]] || {
		log "needs an aarch64 Steam Frame (found $(uname -m))"
		bad=1
	}
	for tool in podman debugfs bsdtar curl sha256sum python3; do
		command -v "$tool" >/dev/null || {
			log "missing tool: $tool"
			bad=1
		}
	done
	if command -v podman >/dev/null &&
		[[ "$(podman version -f '{{.Client.Version}}' 2>/dev/null | cut -d. -f1)" -lt 5 ]]; then
		log "needs podman 5 or newer"
		bad=1
	fi
	[[ -r /dev/dri/renderD128 && -w /dev/dri/renderD128 ]] || {
		log "no access to /dev/dri/renderD128 (GPU)"
		bad=1
	}
	mkdir -p "$BASE"
	free="$(df -Pk "$BASE" | awk 'NR == 2 { print int($4 / 1048576) }')"
	[[ "$free" -ge 8 ]] || {
		log "needs about 8 GB free under $BASE (have ${free} GB)"
		bad=1
	}
	[[ "$bad" == 0 ]] || die "prerequisites not met"
}

steam_running() { pgrep -x steam >/dev/null; }

image_flavor() { cat "$BASE/flavor" 2>/dev/null || echo GAPPS; }

cmd_install() {
	local flavor
	flavor="$(image_flavor)"
	case "${1:-}" in
	--vanilla) flavor=VANILLA ;;
	--gapps) flavor=GAPPS ;;
	"") ;;
	*) die "usage: wgapps install [--vanilla|--gapps]" ;;
	esac
	check_prereqs
	mkdir -p "$BASE/images" "$RUNDIR"
	echo "$flavor" >"$BASE/flavor"
	export WGAPPS_FLAVOR="$flavor"
	rm -f "$BASE/lepton.seccomp.json"
	log "seccomp: using wgapps' own profile (Lepton's, if installed, is not used)"
	if [[ "$flavor" == "VANILLA" ]]; then
		log "downloading Waydroid's images without Google apps from Waydroid (about 1 GB)"
	else
		log "downloading Waydroid's GAPPS images from Waydroid (about 1.3 GB)"
	fi
	"$BIN/fetch-images.sh" || die "download failed; run 'wgapps install' again to resume"
	cmd_prepare --force
	if [[ "${WGAPPS_SKIP_SHORTCUTS:-0}" == "1" ]]; then
		log "skipping Steam shortcuts (WGAPPS_SKIP_SHORTCUTS=1)"
	elif ! python3 "$BIN/steam-shortcuts.py" add Android; then
		# With Steam running this goes through Steam's own client API; Steam need not be closed.
		log "could not add the Android entry to the Steam library. Try again later, or with Steam closed:"
		log "  $BIN/steam-shortcuts.py add Android"
	fi
	local google="  2. Register this device for Google sign-in: print the GSF ID with
       $BIN/wgapps gsf-id
     and enter it at https://www.google.com/android/uncertified"
	[[ "$flavor" == "VANILLA" ]] && google="  2. (no Google apps in this image, so no Google sign-in step)"
	cat >&2 <<NEXT

Installed $(cmd_version). Next:
  1. Launch "Android" from the Steam library (first boot takes about a minute).
$google
  3. Per-app Steam shortcuts (Steam closed):
       $BIN/steam-shortcuts.py add Plex com.plexapp.android
     In Steam, give each one the default Gamepad controller layout.
NEXT
}

cmd_gsf_id() {
	[[ "$(image_flavor)" == "VANILLA" ]] && die "this install has no Google apps (VANILLA), so there is no GSF ID"
	running || die "start Android first"
	# `podman exec` gives the shell none of the environment Android's init sets, and sqlite3 aborts
	# ("Aborted (core dumped)") in ICU's start-up without these: it needs the ICU and time zone roots.
	local id
	id="$(asys "ANDROID_ROOT=/system ANDROID_DATA=/data ANDROID_I18N_ROOT=/apex/com.android.i18n ANDROID_TZDATA_ROOT=/apex/com.android.tzdata sqlite3 /data/data/com.google.android.gsf/databases/gservices.db \"select value from main where name='android_id'\"" | tr -d '\r')" ||
		die "could not read the GSF ID (is Android fully booted and the Google apps image installed?)"
	[[ "$id" =~ ^[0-9]+$ ]] || die "no GSF ID yet: open Google Play services once, or wait a minute after boot"
	echo "$id"
}

image_ref() {
	local want="${1:-}" cur
	cur="$(cat "$BASE/image" 2>/dev/null || echo "$DEFAULT_IMAGE:latest")"
	if [[ -z "$want" ]]; then
		echo "${cur%:*}:latest"
	elif [[ "$want" == */* ]]; then
		echo "$want"
	else
		echo "${cur%:*}:$want"
	fi
}

cmd_update() {
	local ref cid stage="$BASE/.staging" prev="$BASE/.previous" item
	ref="$(image_ref "${1:-}")"
	log "pulling $ref"
	if ! podman pull -q "$ref" >/dev/null 2>&1; then
		podman image exists "$ref" || die "cannot pull $ref"
		log "warning: cannot reach the registry; using the local copy of $ref"
	fi
	rm -rf "$stage"
	mkdir -p "$stage"
	cid="$(podman create "$ref" none)" || die "cannot unpack $ref"
	if ! podman cp "$cid:/wgapps/." "$stage/"; then
		podman rm "$cid" >/dev/null
		die "image $ref has no /wgapps"
	fi
	podman rm "$cid" >/dev/null
	[[ -f "$stage/bin/wgapps" ]] || die "image $ref has no bin/wgapps"
	rm -rf "$prev"
	mkdir -p "$prev"
	for item in bin lib overrides VERSION image; do
		if [[ -e "$BASE/$item" ]]; then mv "$BASE/$item" "$prev/"; fi
	done
	for item in bin lib overrides VERSION; do
		if [[ -e "$stage/$item" ]]; then mv "$stage/$item" "$BASE/"; fi
	done
	chmod 0755 "$BASE"/bin/*
	echo "$ref" >"$BASE/image"
	rm -rf "$stage"
	log "updated to $(cat "$BASE/VERSION" 2>/dev/null || echo unknown) ($ref)"
	if running; then log "restart Android to use it"; fi
}

cmd_rollback() {
	local prev="$BASE/.previous" item
	[[ -f "$prev/bin/wgapps" ]] || die "nothing to roll back to"
	for item in bin lib overrides VERSION image; do
		rm -rf "${BASE:?}/$item"
		if [[ -e "$prev/$item" ]]; then mv "$prev/$item" "$BASE/"; fi
	done
	rm -rf "$prev"
	log "rolled back to $(cat "$BASE/VERSION" 2>/dev/null || echo unknown)"
}

cmd_uninstall() {
	local name
	[[ "${1:-}" == "--yes" ]] ||
		die "this deletes $BASE including all Android data; run: wgapps uninstall --yes"
	cmd_stop
	if steam_running; then
		log "Steam is running; remove the Android shortcuts from the Steam library yourself"
	else
		while IFS=$'\t' read -r name _; do
			python3 "$BIN/steam-shortcuts.py" remove "$name"
		done < <(python3 "$BIN/steam-shortcuts.py" list | grep -F "$BIN/wgapps")
	fi
	podman unshare rm -rf "$BASE"
	log "removed $BASE"
}

cmd_report() {
	local out="${1:-$HOME/wgapps-report-$(date +%Y%m%d-%H%M%S).txt}"
	section() { printf '\n===== %s =====\n' "$1"; }
	(
		set +e +o pipefail
		section "wgapps"
		echo "version: $(cmd_version)"
		echo "date: $(date '+%F %T %z')"
		echo "BASE: $BASE"
		for f in windows gpu-egl apps-kind device.prop; do
			[[ -e "$BASE/$f" ]] && printf '%s: %s\n' "$f" "$(tr '\n' ' ' <"$BASE/$f")"
		done
		section "host"
		uname -a
		grep -E '^(PRETTY_NAME|VARIANT_ID|BUILD_ID)=' /etc/os-release 2>/dev/null
		podman --version 2>&1
		df -h "$BASE" "$HOME" 2>&1
		free -m 2>&1
		section "steam"
		echo "steam running: $(pgrep -x steam >/dev/null && echo yes || echo no)"
		pgrep -ax gamescope 2>&1 | cut -c1-200
		echo "seccomp profile: wgapps' own"
		echo "Lepton installed: $([[ -f "$LEPTON_SECCOMP" ]] && echo yes || echo no)"
		section "container"
		podman ps -a --filter "name=$NAME" 2>&1
		podman inspect "$NAME" --format 'state={{.State.Status}} exit={{.State.ExitCode}} oom={{.State.OOMKilled}} started={{.State.StartedAt}} finished={{.State.FinishedAt}}' 2>&1
		section "status"
		cmd_status 2>&1
		section "podman logs (last 200 lines)"
		podman logs --tail 200 "$NAME" 2>&1
		section "Android init (run/kmsg.log, last 300 lines)"
		tail -n 300 "$RUNDIR/kmsg.log" 2>&1
		section "waydroid.prop"
		grep -vE 'gsf|android_id|serial|imei|mac' "$RUNDIR/waydroid.prop" 2>&1
		section "image"
		cat "$BASE/images/variant" 2>&1
		ls -l "$BASE/images" 2>&1
		if running; then
			section "Android logcat (last 1500 lines)"
			podman exec "$NAME" /system/bin/logcat -d -t 1500 2>&1
			section "Android tombstones"
			asys 'ls -l /data/tombstones 2>/dev/null | tail -n 10' 2>&1
		fi
	) >"$out" 2>&1
	log "wrote $out ($(wc -c <"$out") bytes); read it before sharing"
	echo "$out"
}

cmd_version() {
	echo "$(cat "$BASE/VERSION" 2>/dev/null || echo dev) ($(cat "$BASE/images/variant" 2>/dev/null || echo "no Android images"))"
}

main() {
	local cmd="${1:-help}"
	shift || true
	case "$cmd" in
	install) cmd_install "$@" ;;
	update) cmd_update "$@" ;;
	rollback) cmd_rollback ;;
	uninstall) cmd_uninstall "$@" ;;
	version) cmd_version ;;
	gsf-id) cmd_gsf_id ;;
	prepare) cmd_prepare "$@" ;;
	_migrate-ids) migrate_data_ids "$@" ;;
	_repair-keystore) repair_keystore_owner "$@" ;;
	start) cmd_start "$@" ;;
	stop) cmd_stop ;;
	status) cmd_status ;;
	wait-boot) cmd_wait_boot "$@" ;;
	sh)
		if [[ $# -gt 0 ]]; then
			asys "$*"
		else
			podman exec -it "$NAME" /system/bin/sh
		fi
		;;
	logcat) podman exec "$NAME" /system/bin/logcat "$@" ;;
	launch) cmd_launch "$@" ;;
	run) cmd_run "$@" ;;
	app) cmd_app "$@" ;;
	apps) cmd_apps "$@" ;;
	windows) cmd_windows "$@" ;;
	gpu) cmd_gpu "$@" ;;
	xr) cmd_xr "$@" ;;
	share) cmd_share "$@" ;;
	mode) cmd_mode "$@" ;;
	view) cmd_view "$@" ;;
	report) cmd_report "$@" ;;
	steam) cmd_steam "$@" ;;
	help | -h | --help) usage ;;
	*)
		usage
		exit 2
		;;
	esac
}

# Sourced by tests/test_xr.py, which calls the functions directly.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
	main "$@"
fi
