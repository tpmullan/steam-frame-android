+
+//#define LOG_NDEBUG 0
+#define LOG_TAG "V4L2ClientPluginStore"
+
+#include <C2AllocatorGralloc.h>
+#include <C2Buffer.h>
+
+#include <v4l2_codec2/plugin_store/V4L2AllocatorId.h>
+
+// The V4L2 plugin store as Codec2 *clients* see it: the MediaCodec inside an app (Chrome, Wolvic), which
+// cannot load vendor libraries. Codec2's allocator store asks the plugin whether an allocator id exists
+// before the client names it as a component's output allocator. Without an answer the client falls back
+// to a plain buffer-queue pool and the V4L2 components, which expect their own pool type, crash.
+//
+// The pools themselves are created in the HAL service by the real plugin (libc2plugin_store, the
+// vendor build in this directory), so this library only has to know the ids and gives no pools.
+extern "C" ::C2Allocator* CreateAllocator(::C2Allocator::id_t allocatorId, ::c2_status_t* status) {
+    switch (allocatorId) {
+    case ::android::V4L2AllocatorId::V4L2_BUFFERQUEUE:
+    case ::android::V4L2AllocatorId::V4L2_BUFFERPOOL:
+    case ::android::V4L2AllocatorId::SECURE_LINEAR:
+    case ::android::V4L2AllocatorId::SECURE_GRAPHIC:
+        *status = C2_OK;
+        return new ::android::C2AllocatorGralloc(allocatorId, true);
+    default:
+        *status = C2_BAD_INDEX;
+        return nullptr;
+    }
+}
+
+extern "C" ::C2BlockPool* CreateBlockPool(::C2Allocator::id_t /* allocatorId */,
+                                          ::C2BlockPool::local_id_t /* poolId */) {
+    return nullptr;
+}
